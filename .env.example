# VideoCapsule 环境变量配置
# 复制此文件为 .env 并填入实际值

# === API Keys ===
# 硅基流动 API Key (用于 ASR 语音识别)
# 获取地址: https://cloud.siliconflow.cn/i/TxUlXG3u
API_KEY=sk-xxxxxxxxxxxxxxxx

# DeepSeek API Key (用于 AI 榨汁，通过 LiteLLM 调用)
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# === LLM 配置 ===
# LiteLLM 模型标识 (默认 DeepSeek-V3)
LLM_MODEL=deepseek/deepseek-chat

# === 服务配置 ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# === 数据库 ===
DATABASE_URL=sqlite:///./videocapsule.db

# === 每日视频摘要邮件（可选）===
# 未配置 SMTP 或未完成账号邮箱验证时，只生成站内摘要，不会外发。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=知萃
SMTP_USE_TLS=true
SMTP_USE_SSL=false
PUBLIC_APP_URL=https://luxai.cn
# 完成发件域名和账号邮箱验证策略后再显式打开。
EMAIL_DELIVERY_ENABLED=false

# 数据库定时任务；关闭后仍可手动生成摘要。
AGENT_AUTOMATION_ENABLED=true
AGENT_AUTOMATION_POLL_SECONDS=30
