# VideoCapsule 环境变量配置
# 复制此文件为 .env 并填入实际值

# === API Keys ===
# 硅基流动 API Key (用于 ASR 语音识别)
# 获取地址: https://cloud.siliconflow.cn/i/TxUlXG3u
API_KEY=sk-xxxxxxxxxxxxxxxx

# DeepSeek API Key (用于 AI 榨汁，通过 LiteLLM 调用)
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# === LLM 配置 ===
# LiteLLM 模型标识 (默认 DeepSeek-V3)
LLM_MODEL=deepseek/deepseek-chat

# === OmniRoute 智能路由（可选）===
# 先按 deploy/omniroute/README.md 启动仅监听本机的网关。
# 留空时用户继续使用知萃基础 AI，前端不会显示为可用。
OMNIROUTE_API_BASE=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
# 仅管理员可见的独立高级控制台地址；应继续启用 OmniRoute 自身登录保护。
OMNIROUTE_DASHBOARD_URL=

# === 小红书增强解析（可选）===
# 独立启动 integrations/XHS-Downloader：python main.py api
# 未启动时会回退到内置正文抓取，但视频地址和视频语音可能不可用。
XHS_DOWNLOADER_API_BASE=http://127.0.0.1:5556
XHS_DOWNLOADER_TIMEOUT_SECONDS=20
# 仅后端使用；不要提交真实 Cookie，也不要暴露给浏览器。
XHS_COOKIE=

# === 服务配置 ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# === 数据库 ===
DATABASE_URL=sqlite:///./videocapsule.db

# === 每日视频摘要邮件（可选）===
# 未配置 SMTP 或未完成账号邮箱验证时，只生成站内摘要，不会外发。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=知萃
SMTP_USE_TLS=true
SMTP_USE_SSL=false
PUBLIC_APP_URL=https://luxai.cn
# 完成发件域名和账号邮箱验证策略后再显式打开。
EMAIL_DELIVERY_ENABLED=false

# 数据库定时任务；关闭后仍可手动生成摘要。
AGENT_AUTOMATION_ENABLED=true
AGENT_AUTOMATION_POLL_SECONDS=30

# === 按需详细视频解析 ===
# 默认必须保持关闭；管理员测试 Provider、发布 Offering 后再在管理端开启。
VIDEO_ANALYSIS_ENABLED=false
VIDEO_ANALYSIS_MAX_WORKERS=1
VIDEO_ANALYSIS_POLL_SECONDS=5
VIDEO_ANALYSIS_HEARTBEAT_SECONDS=15
VIDEO_ANALYSIS_RECOVERY_SECONDS=60
# 保存平台视觉 Provider / 用户视觉 BYOK 密钥前必须配置 Fernet key：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# 前端本地开发默认也走真实登录/注册；仅明确需要自动开发账号时设为 true。
NEXT_PUBLIC_DEV_AUTH_AUTO=false
