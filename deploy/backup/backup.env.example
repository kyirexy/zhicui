# 安装到 /etc/zhicui/backup.env，权限必须为 0640 root:postgres。
PGDATABASE=zhicui
ZHICUI_BACKUP_DIR=/var/backups/zhicui
ZHICUI_BACKUP_STATE_DIR=/var/lib/zhicui-backups
ZHICUI_BACKUP_KEY_FILE=/etc/zhicui/backup.key
ZHICUI_BACKUP_RETENTION_DAYS=14
BACKUP_STATUS_FILE=/var/lib/zhicui-backups/latest.json

# 默认强制异地故障域副本。早期阶段若明确接受单机风险，可设为 false；此时后端还必须
# 同时设置 BACKUP_OFFSITE_REQUIRED=false 与 EARLY_STAGE_LOCAL_BACKUP_ACCEPTED=true。
# 本机模式仍执行加密、SHA-256 和隔离恢复，不会伪报异地验证成功。
ZHICUI_OFFSITE_REQUIRED=true
# 二选一：rclone（推荐，适配 S3-compatible/object storage）或 ssh。
ZHICUI_OFFSITE_MODE=rclone
ZHICUI_OFFSITE_RECOVERY_MATERIAL=/etc/zhicui/offsite-recovery.age

# rclone 模式：凭据只写入 0640 root:postgres 的配置文件，REMOTE 格式为 remote:bucket/prefix。
ZHICUI_OFFSITE_RCLONE_CONFIG=/etc/zhicui/rclone.conf
ZHICUI_OFFSITE_RCLONE_REMOTE=CHANGE_ME_REMOTE:CHANGE_ME_BUCKET/zhicui/postgres

# SSH 模式（选用时取消注释并清空 rclone 目标）。私钥/known_hosts 均须 root:postgres 0640。
# ZHICUI_OFFSITE_SSH_TARGET=backup@CHANGE_ME_HOST
# ZHICUI_OFFSITE_SSH_DIRECTORY=/srv/zhicui-backups
# ZHICUI_OFFSITE_SSH_KEY_FILE=/etc/zhicui/offsite_ed25519
# ZHICUI_OFFSITE_SSH_KNOWN_HOSTS_FILE=/etc/zhicui/offsite_known_hosts
