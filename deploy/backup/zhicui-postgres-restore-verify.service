[Unit]
Description=Zhicui isolated PostgreSQL restore and offsite verification
After=postgresql.service zhicui-postgres-backup.service
Wants=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
UMask=0027
Environment=PGDATABASE=zhicui
EnvironmentFile=-/etc/zhicui/backup.env
ExecStart=/usr/local/lib/zhicui-backup/postgres-restore-verify.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/zhicui /var/lib/zhicui-backups
CapabilityBoundingSet=
LockPersonality=true
