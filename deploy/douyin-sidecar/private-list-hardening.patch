@@ -0,0 +1,143 @@
+"""Hash-pinned SecSDK signing for the scoped Douyin likes request.
+
+This module is adapted from the MIT-licensed ``douyin-mcp-server`` reference
+implementation.  It never logs or returns Cookie values, full URLs, or the
+generated signature material.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+from typing import Dict, Tuple
+from urllib.parse import parse_qs, urlsplit
+from urllib.error import HTTPError, URLError
+from urllib.request import Request, urlopen
+
+
+_RUNTIME_URL = "https://lf-security.bytegoofy.com/obj/security-secsdk/runtime_bundler_34.js"
+_RUNTIME_SHA256 = "6922fc6f30ff67918c2c6d9493292ae4266635a9d8f7ec030f80e2bed3d36272"
+_RUNTIME_MAX_BYTES = 512 * 1024
+_CACHE_ROOT = Path(
+    os.environ.get("XDG_CACHE_HOME")
+    or (Path.home() / ".cache")
+) / "zhicui-douyin"
+_RUNTIME_PATH = _CACHE_ROOT / "websign" / "runtime_bundler_34.js"
+_RUNNER_PATH = Path(__file__).with_name("private_list_websign_runner.js")
+_MARKER = "__DOUYIN_WEBSIGN__"
+
+
+class PrivateListWebSignError(RuntimeError):
+    """Safe signing failure without identity or signature material."""
+
+
+def _valid_runtime(path: Path) -> bool:
+    try:
+        payload = path.read_bytes()
+    except OSError:
+        return False
+    return (
+        len(payload) <= _RUNTIME_MAX_BYTES
+        and hashlib.sha256(payload).hexdigest() == _RUNTIME_SHA256
+    )
+
+
+def ensure_runtime() -> Path:
+    """Return the verified runtime, downloading the pinned asset when absent."""
+    if _valid_runtime(_RUNTIME_PATH):
+        return _RUNTIME_PATH
+    try:
+        request = Request(_RUNTIME_URL, headers={"User-Agent": "Zhicui-Sidecar/1"})
+        with urlopen(request, timeout=15) as response:
+            payload = response.read(_RUNTIME_MAX_BYTES + 1)
+    except (HTTPError, URLError, OSError) as exc:
+        raise PrivateListWebSignError("SecSDK 签名运行时下载失败") from exc
+    if (
+        len(payload) > _RUNTIME_MAX_BYTES
+        or hashlib.sha256(payload).hexdigest() != _RUNTIME_SHA256
+    ):
+        raise PrivateListWebSignError("SecSDK 签名运行时完整性校验失败")
+    _RUNTIME_PATH.parent.mkdir(parents=True, exist_ok=True)
+    temporary = _RUNTIME_PATH.with_suffix(".tmp")
+    temporary.write_bytes(payload)
+    temporary.replace(_RUNTIME_PATH)
+    return _RUNTIME_PATH
+
+
+def _cookie_header(cookies: Dict[str, str]) -> str:
+    pairs = []
+    for raw_name, raw_value in cookies.items():
+        name = str(raw_name or "").strip()
+        value = str(raw_value or "").strip()
+        if name and value and not any(char in name + value for char in "\r\n;"):
+            pairs.append("{}={}".format(name, value))
+    return "; ".join(pairs)
+
+
+def sign_url(
+    url: str,
+    cookies: Dict[str, str],
+    user_agent: str,
+) -> Tuple[str, Dict[str, str]]:
+    """Append fresh SecSDK parameters using the local hash-pinned runtime."""
+    runtime = ensure_runtime()
+    node_executable = shutil.which("node")
+    if not node_executable:
+        raise PrivateListWebSignError("SecSDK 签名运行时缺少 Node.js")
+    input_payload = json.dumps(
+        {
+            "url": url,
+            "cookie": _cookie_header(cookies),
+            "user_agent": user_agent,
+            "runtime_path": str(runtime),
+            "page_url": "https://www.douyin.com/user/self?showTab=like",
+        }
+    )
+    try:
+        completed = subprocess.run(
+            [node_executable, str(_RUNNER_PATH)],
+            input=input_payload,
+            capture_output=True,
+            text=True,
+            timeout=12,
+        )
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        raise PrivateListWebSignError("SecSDK 签名运行时执行失败") from exc
+
+    marker_at = completed.stdout.rfind(_MARKER)
+    if marker_at < 0:
+        raise PrivateListWebSignError("SecSDK 签名运行时返回无效结果")
+    try:
+        result = json.loads(completed.stdout[marker_at + len(_MARKER) :])
+    except (TypeError, json.JSONDecodeError) as exc:
+        raise PrivateListWebSignError("SecSDK 签名运行时返回无效结果") from exc
+    signed_url = result.get("url") if isinstance(result, dict) else None
+    if completed.returncode != 0 or not isinstance(signed_url, str):
+        raise PrivateListWebSignError("SecSDK 签名生成失败")
+
+    before = urlsplit(url)
+    after = urlsplit(signed_url)
+    if (before.scheme, before.netloc, before.path) != (
+        after.scheme,
+        after.netloc,
+        after.path,
+    ):
+        raise PrivateListWebSignError("SecSDK 签名结果目标不匹配")
+    query = parse_qs(after.query, keep_blank_values=True)
+    signature = query.get("x-secsdk-web-signature", [""])[0]
+    if not (query.get("uifid") and query.get("timestamp") and len(signature) == 32):
+        raise PrivateListWebSignError("SecSDK 签名结果缺少必需参数")
+
+    headers = result.get("headers") if isinstance(result.get("headers"), dict) else {}
+    safe_headers = {
+        str(key): str(value)
+        for key, value in headers.items()
+        if key in {"uifid", "x-secsdk-web-signature", "x-secsdk-web-expire"}
+        and isinstance(value, str)
+        and len(value) <= 512
+    }
+    return signed_url, safe_headers
