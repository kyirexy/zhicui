+def _private_list_readiness(cookies: Dict[str, str]) -> Dict[str, Any]:
+    """Return capability booleans without exposing private Cookie values."""
+    normalized = {
+        str(name or "").strip().lower(): str(value or "").strip()
+        for name, value in (cookies or {}).items()
+        if str(name or "").strip() and str(value or "").strip()
+    }
+    authenticated = any(
+        bool(normalized.get(name.lower()))
+        for name in AUTHENTICATED_SESSION_COOKIE_NAMES
+    )
+    missing: List[str] = []
+    if not authenticated:
+        missing.append("authenticated_session")
+    # UIFID_TEMP is deliberately not accepted: Argus requires the final UIFID.
+    if not normalized.get("uifid"):
+        missing.append("UIFID")
+    return {
+        "like_ready": authenticated,
+        "collection_ready": authenticated and "UIFID" not in missing,
+        "missing_requirements": missing,
+    }
