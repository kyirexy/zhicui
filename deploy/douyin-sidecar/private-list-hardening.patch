diff --git a/tests/test_api_client.py b/tests/test_api_client.py
index 1f9fd11..4f47339 100644
--- a/tests/test_api_client.py
+++ b/tests/test_api_client.py
@@ -7,0 +8 @@ import pytest
+import core.api_client as api_client_module
@@ -36,0 +38,60 @@ def test_build_signed_path_accepts_absolute_base_override():
+@pytest.mark.asyncio
+async def test_verified_likes_use_websign_and_require_explicit_list(monkeypatch):
+    client = DouyinAPIClient({"msToken": "token-1", "sessionid": "private"})
+    captured = {}
+
+    monkeypatch.setattr(
+        client,
+        "_build_abogus_url",
+        lambda *_args, **_kwargs: ("https://www-hj.douyin.com/favorite?a_bogus=x", "ua"),
+    )
+    monkeypatch.setattr(
+        api_client_module,
+        "sign_private_list_url",
+        lambda url, _cookies, _ua: (url + "&uifid=safe", {"uifid": "safe"}),
+    )
+
+    async def fake_request(path, prepared_url, *, request_headers=None):
+        captured.update(
+            path=path,
+            prepared_url=prepared_url,
+            request_headers=dict(request_headers or {}),
+        )
+        return {
+            "status_code": 0,
+            "aweme_list": [{"aweme_id": "liked-1"}],
+            "has_more": 1,
+            "max_cursor": 10,
+        }
+
+    monkeypatch.setattr(client, "_request_prepared_json", fake_request)
+
+    result = await client.get_user_like_plain("self", max_cursor=0, count=5)
+
+    assert captured["path"] == "/aweme/v1/web/aweme/favorite/"
+    assert captured["prepared_url"].startswith("https://www-hj.douyin.com/")
+    assert result["complete"] is True
+    assert result["items"] == [{"aweme_id": "liked-1"}]
+
+
+def test_private_list_response_rejects_missing_list_shape():
+    client = DouyinAPIClient({"msToken": "token-1"})
+
+    result = client._normalize_private_list_response(
+        {"status_code": 0, "has_more": 0},
+        source="api_websign",
+    )
+
+    assert result["complete"] is False
+    assert result["items"] == []
+    assert client.last_response_signal == "connector_error"
+
+
+def test_private_list_block_signal_distinguishes_missing_uifid():
+    assert DouyinAPIClient._response_block_signal(
+        403,
+        b"Blocked by ArgusSecurityPlugin Uifid Not Found",
+    ) == "argus_uifid_missing"
+    assert DouyinAPIClient._response_block_signal(403, b"forbidden") == "risk_controlled"
+
+
