+    @staticmethod
+    def _response_block_signal(status: int, body: bytes) -> str:
+        """Classify a bounded upstream failure without retaining its payload."""
+        marker = body[:1024].decode("utf-8", errors="ignore").lower()
+        if "uifid not found" in marker:
+            return "argus_uifid_missing"
+        if "verify" in marker or "captcha" in marker:
+            return "verification_required"
+        if status in {401, 419}:
+            return "session_expired"
+        if status in {403, 429} or "argussecurityplugin" in marker:
+            return "risk_controlled"
+        return "connector_error"
+
+    async def _request_prepared_json(
+        self,
+        path: str,
+        prepared_url: str,
+        *,
+        request_headers: Optional[Dict[str, str]] = None,
+    ) -> Dict[str, Any]:
+        """Execute one pre-signed private-list request with redacted diagnostics."""
+        await self._ensure_session()
+        self.last_http_status = 0
+        self.last_http_path = path
+        self.last_response_signal = ""
+        started = time.monotonic()
+        logger.info("Douyin private-list request: path=%s", path)
+        try:
+            async with self._session.get(
+                prepared_url,
+                headers={
+                    **self.headers,
+                    **(request_headers or {}),
+                },
+                proxy=self.proxy or None,
+            ) as response:
+                self.last_http_status = int(response.status)
+                body = await response.read()
+                if response.status != 200:
+                    self.last_response_signal = self._response_block_signal(
+                        int(response.status),
+                        body,
+                    )
+                    logger.warning(
+                        "Douyin private-list failure: path=%s status=%s signal=%s "
+                        "duration_ms=%d",
+                        path,
+                        response.status,
+                        self.last_response_signal,
+                        _elapsed_ms(started),
+                    )
+                    return {}
+                if not body:
+                    self.last_response_signal = "risk_controlled"
+                    logger.warning(
+                        "Douyin private-list empty response: path=%s duration_ms=%d",
+                        path,
+                        _elapsed_ms(started),
+                    )
+                    return {}
+                try:
+                    data = json.loads(body)
+                except (TypeError, ValueError, json.JSONDecodeError):
+                    self.last_response_signal = "connector_error"
+                    logger.warning(
+                        "Douyin private-list non-JSON response: path=%s bytes=%d "
+                        "duration_ms=%d",
+                        path,
+                        len(body),
+                        _elapsed_ms(started),
+                    )
+                    return {}
+                result = data if isinstance(data, dict) else {}
+                if _is_login_required(result):
+                    self.last_response_signal = "session_expired"
+                    return {}
+                _log_api_response(path, 0, 1, body, result, started)
+                return result
+        except (aiohttp.ClientError, asyncio.TimeoutError) as exc:
+            self.last_response_signal = "network_error"
+            logger.warning(
+                "Douyin private-list network failure: path=%s duration_ms=%d "
+                "error_type=%s",
+                path,
+                _elapsed_ms(started),
+                type(exc).__name__,
+            )
+            return {}
+
+    def _normalize_private_list_response(
+        self,
+        raw_data: Any,
+        *,
+        source: str,
+    ) -> Dict[str, Any]:
+        raw = raw_data if isinstance(raw_data, dict) else {}
+        status_code = raw.get("status_code")
+        complete = status_code in {0, "0"} and isinstance(raw.get("aweme_list"), list)
+        if not complete and not self.last_response_signal:
+            if _is_login_required(raw):
+                self.last_response_signal = "session_expired"
+            elif raw.get("verify_ticket"):
+                self.last_response_signal = "verification_required"
+            else:
+                self.last_response_signal = "connector_error"
+        normalized = self._normalize_paged_response(
+            raw,
+            item_keys=["aweme_list"],
+            source=source,
+        )
+        normalized["complete"] = complete
+        return normalized
+
