+    deps.fetch_status.update(
+        message="正在排队等待安全登录浏览器…",
+        browser_mode="queued",
+        browser_opened=False,
+    )
+    await deps.login_browser_semaphore.acquire()
+    try:
+        if deps.fetch_cancel_event.is_set():
+            raise asyncio.CancelledError()
+        deps.fetch_worker_running = True
+        deps.fetch_status.update(
+            message="正在启动抖音安全登录浏览器…",
+            browser_mode="starting",
+        )
+
+        def _runner() -> Dict[str, str]:
+            try:
+                return asyncio.run(_fetch_cookie_auto_worker(deps, browser))
+            finally:
+                deps.fetch_worker_running = False
+                deps.fetch_driver_process = None
+
+        worker = loop.run_in_executor(None, _runner)
+        try:
+            try:
+                return await asyncio.wait_for(
+                    asyncio.shield(worker),
+                    timeout=10.0,
+                )
+            except asyncio.TimeoutError:
+                if _env_flag("DOUYIN_BROWSER_HEADLESS", False):
+                    deps.fetch_cancel_event.set()
+                    raise RuntimeError(
+                        "抖音登录页面加载超时或触发了交互式安全验证，"
+                        "当前无界面环境无法完成；请在桌面端绑定或稍后重试"
+                    )
+                deps.fetch_status["message"] = (
+                    "抖音页面正在加载或要求安全验证："
+                    "如弹出的浏览器显示拼图，请完成后等待二维码自动出现"
+                )
+                return await asyncio.shield(worker)
+        except asyncio.CancelledError:
+            deps.fetch_cancel_event.set()
+            raise
+    except asyncio.CancelledError:
+        deps.fetch_cancel_event.set()
+        raise
+    finally:
+        deps.login_browser_semaphore.release()
