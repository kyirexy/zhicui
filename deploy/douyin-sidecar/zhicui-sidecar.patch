+                if browser_user_visible
+                else "正在打开抖音登录页面并获取二维码…"
+            )
+            open_task = asyncio.create_task(_open_douyin_login(page))
+            parent_task = asyncio.current_task()
+
+            async def _navigation_watchdog() -> None:
+                await asyncio.sleep(10)
+                if open_task.done() or not deps.fetch_status.get("running"):
+                    return
+                if headless:
+                    deps.fetch_status.update(
+                        running=False,
