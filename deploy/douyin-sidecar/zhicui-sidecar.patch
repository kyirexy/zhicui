+        previous_items = previous_snapshot.get("items")
+        if isinstance(previous_items, list) and previous_items:
+            raise RuntimeError(
+                f"未读取到{source_label}，已保留上次同步结果；"
+                "请确认抖音登录状态后重试"
+            )
+        return {"total": 0, "success": 0, "failed": 0, "skipped": 0}
