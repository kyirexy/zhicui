+def _safe_creator_catalog_item(item: Dict[str, Any], order_index: int) -> Dict[str, Any]:
+    """Project one aweme onto the sidecar's credential/media-safe contract."""
+    aweme_id = str(item.get("aweme_id") or "").strip()[:192]
+    author = item.get("author") if isinstance(item.get("author"), dict) else {}
+    images = item.get("images") if isinstance(item.get("images"), list) else []
+    if not images and isinstance(item.get("image_list"), list):
+        images = item["image_list"]
+    description = str(item.get("desc") or "").replace("\x00", "").strip()[:5000]
+    title = description.splitlines()[0].strip()[:300] if description else ""
+    video = item.get("video") if isinstance(item.get("video"), dict) else {}
+    try:
+        duration_ms = int(video.get("duration") or item.get("duration") or 0)
+    except (TypeError, ValueError):
+        duration_ms = 0
+    try:
+        publish_timestamp = int(item.get("create_time") or 0) or None
+    except (TypeError, ValueError):
+        publish_timestamp = None
+    return {
+        "aweme_id": aweme_id,
+        "source_url": f"https://www.douyin.com/video/{aweme_id}",
+        "title": title or f"抖音作品 {aweme_id}",
+        "description": description,
+        "author_name": str(author.get("nickname") or "").replace("\x00", "").strip()[:160],
+        "publish_timestamp": publish_timestamp,
+        "duration_ms": max(0, min(duration_ms, 7 * 24 * 60 * 60 * 1000)),
+        "media_type": "gallery" if images else "video",
+        "order_index": max(0, int(order_index)),
+        # CDN covers are signed/ephemeral media URLs. Full-catalog responses
+        # intentionally omit them rather than inviting durable persistence.
+        "cover_url": "",
+    }
+
