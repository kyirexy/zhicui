+async def _capture_qr_png(page: Any) -> Optional[bytes]:
+    """截取一个可见、尺寸合理的二维码候选。"""
+    for selector in QR_SELECTORS:
+        try:
+            candidates = page.locator(selector)
+            count = min(await candidates.count(), 6)
+        except Exception:
+            continue
+        for index in range(count):
+            candidate = candidates.nth(index)
+            try:
+                if not await candidate.is_visible():
+                    continue
+                box = await candidate.bounding_box()
+                if not box:
+                    continue
+                width = float(box.get("width") or 0)
+                height = float(box.get("height") or 0)
+                if not (100 <= width <= 520 and 100 <= height <= 520):
+                    continue
+                if abs(width - height) > max(width, height) * 0.24:
+                    continue
+                image = await candidate.screenshot(type="png")
+                if 500 <= len(image) <= MAX_QR_IMAGE_BYTES:
+                    return image
+            except Exception:
+                continue
+
+    # 抖音登录组件有时使用 closed shadow root，DOM selector 无法进入。
+    # 对当前视口截图做 QR 定位，只返回二维码裁剪，不暴露整个页面。
+    try:
+        screenshot = await page.screenshot(type="png")
+        loop = asyncio.get_running_loop()
+        return await loop.run_in_executor(None, _crop_qr_from_screenshot, screenshot)
+    except Exception:
+        return None
+
+
+def _crop_qr_from_screenshot(screenshot: bytes) -> Optional[bytes]:
+    """使用 OpenCV 定位并裁剪二维码；无法解码时不返回页面截图。"""
+    try:
+        import cv2
+        import numpy as np
+    except ImportError:
+        return None
+    if not screenshot or len(screenshot) > 8 * 1024 * 1024:
+        return None
+    matrix = cv2.imdecode(
+        np.frombuffer(screenshot, dtype=np.uint8),
+        cv2.IMREAD_COLOR,
+    )
+    if matrix is None:
+        return None
+    detector = cv2.QRCodeDetector()
+    _, points, _ = detector.detectAndDecode(matrix)
+    if points is None:
+        detected, points = detector.detect(matrix)
+        if not detected or points is None:
+            return None
+    flattened = points.reshape(-1, 2)
+    x1 = max(0, int(flattened[:, 0].min()) - 16)
+    y1 = max(0, int(flattened[:, 1].min()) - 16)
+    x2 = min(matrix.shape[1], int(flattened[:, 0].max()) + 17)
+    y2 = min(matrix.shape[0], int(flattened[:, 1].max()) + 17)
+    if x2 - x1 < 100 or y2 - y1 < 100:
+        return None
+    crop = matrix[y1:y2, x1:x2]
+    encoded, buffer = cv2.imencode(".png", crop)
+    if not encoded:
+        return None
+    image = buffer.tobytes()
+    if not (500 <= len(image) <= MAX_QR_IMAGE_BYTES):
+        return None
+    return image
+
