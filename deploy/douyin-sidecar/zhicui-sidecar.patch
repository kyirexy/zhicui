+class _SessionDeps:
+    """All mutable Douyin state belonging to one opaque Zhicui scope."""
+
+    def __init__(
+        self,
+        owner: "_ServerDeps",
+        scope: str,
+    ):
+        self.scope = scope
+        self.config = owner.config
+        self.metadata_only = owner.metadata_only
+        self.rate_limiter = owner.rate_limiter
+        self.retry_handler = owner.retry_handler
+        self.queue_manager = owner.queue_manager
+
+        if scope == DEFAULT_SESSION_SCOPE:
+            cookie_file = owner.legacy_cookie_file
+            library_path = str(owner.config.get("path") or "./Downloaded")
+        else:
+            scope_root = owner.sessions_root / scope
+            scope_root.mkdir(parents=True, exist_ok=True)
+            if os.name != "nt":
+                os.chmod(scope_root, 0o700)
+            cookie_file = str(scope_root / "cookies.json")
+            library_path = str(scope_root / "library")
+
+        self.cookie_manager = CookieManager(cookie_file=cookie_file)
+        if scope == DEFAULT_SESSION_SCOPE:
+            # The standalone console preserves its existing config fallback.
+            # Scoped Zhicui users never inherit the legacy/global Cookie.
+            disk_cookies = self.cookie_manager.get_cookies()
+            if not disk_cookies:
+                initial_cookies = owner.config.get_cookies()
+                if initial_cookies:
+                    self.cookie_manager.set_cookies(initial_cookies)
+
+        self.file_manager = FileManager(library_path)
+        self.source_order_path = (
+            self.file_manager.base_path / SOURCE_ORDER_FILENAME
+        )
+        self.source_order_lock = asyncio.Lock()
+        self.catalog_path = (
+            self.file_manager.base_path / LIBRARY_CATALOG_FILENAME
