+        80,
+        80,
+        120,
+        120,
+        cv2.BORDER_CONSTANT,
+        value=255,
+    )
+    encoded, buffer = cv2.imencode(".png", canvas)
+    assert encoded
+
+    cropped = server_app._crop_qr_from_screenshot(buffer.tobytes())
+
+    assert cropped is not None
+    cropped_matrix = cv2.imdecode(
+        __import__("numpy").frombuffer(cropped, dtype="uint8"),
+        cv2.IMREAD_GRAYSCALE,
+    )
+    assert cropped_matrix.shape[0] < canvas.shape[0]
+    assert cropped_matrix.shape[1] < canvas.shape[1]
 
 
