+def _catalog_risk_detected(page: Dict[str, Any]) -> bool:
+    flags = page.get("risk_flags")
+    if isinstance(flags, dict) and any(bool(value) for value in flags.values()):
+        return True
+    status_code = page.get("status_code")
+    return status_code not in {None, 0, "0"}
