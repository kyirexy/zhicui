+async def _resolve_self_sec_uid(api_client) -> str:
+    """用当前 cookie 调 profile/self/ 拿登录用户的真 sec_uid。
+
+    抖音的 favorite（喜欢）和 post（主页发布）API 都要真 sec_uid，
+    self 链接解析出的 "self" 字符串它们不认；cookie 作用域的 collection
+    与 collects/list 接受 "self" 上下文。所以 like/post 模式下要先解出真 sec_uid。
+    """
+    try:
+        params = await api_client._default_query()
