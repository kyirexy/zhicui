+def _terminate_login_driver(deps: "_SessionDeps") -> bool:
+    """Terminate only the Playwright process tree owned by this login session."""
+    process = deps.fetch_driver_process
+    pid = int(getattr(process, "pid", 0) or 0)
+    if pid <= 0 or pid == os.getpid() or getattr(process, "returncode", None) is not None:
+        return False
+    try:
+        if os.name == "nt":
+            completed = subprocess.run(
+                ["taskkill", "/PID", str(pid), "/T", "/F"],
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,
+                timeout=5,
+                check=False,
+                creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
+            )
+            return completed.returncode == 0
+        os.kill(pid, signal.SIGTERM)
