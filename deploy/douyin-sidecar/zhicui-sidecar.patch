+                if not media_info:
+                    raise HTTPException(status_code=422, detail="该作品没有可播放视频")
+                target_url, target_headers = media_info
+                scoped.media_stream_cache[clean_id] = (
+                    time.monotonic() + MEDIA_STREAM_CACHE_TTL_SECONDS,
+                    target_url,
+                    dict(target_headers),
+                )
+                return target_url, dict(target_headers)
+
+        target_url, target_headers = await resolve_media()
+        range_header = request.headers.get("range")
+        if range_header:
+            target_headers["Range"] = range_header
+        session = aiohttp.ClientSession()
+        upstream = None
+        try:
+            for attempt in range(2):
+                upstream = await session.get(
+                    target_url,
+                    headers=target_headers,
+                    proxy=deps.config.get("proxy") or None,
+                    timeout=aiohttp.ClientTimeout(total=600),
+                )
+                if upstream.status < 400:
+                    break
+                detail_text = await upstream.text()
+                upstream.release()
+                if attempt == 0:
+                    scoped.media_stream_cache.pop(clean_id, None)
+                    target_url, target_headers = await resolve_media(force=True)
+                    if range_header:
+                        target_headers["Range"] = range_header
+                    continue
+                raise HTTPException(
+                    status_code=502,
+                    detail=f"抖音媒体流返回 {upstream.status}: {detail_text[:120]}",
+                )
+        except Exception:
+            if upstream is not None:
+                upstream.release()
+            if not session.closed:
+                await session.close()
+            raise
+
+        async def body():
+            try:
+                async for chunk in upstream.content.iter_chunked(256 * 1024):
+                    if chunk:
+                        yield chunk
+            finally:
+                upstream.release()
+                await session.close()
+
+        response_headers = {
+            "Cache-Control": "private, no-store",
+            "Accept-Ranges": upstream.headers.get("Accept-Ranges", "bytes"),
+        }
+        for source, target in (
+            ("Content-Length", "Content-Length"),
+            ("Content-Range", "Content-Range"),
+        ):
+            value = upstream.headers.get(source)
+            if value:
+                response_headers[target] = value
+        return StreamingResponse(
+            body(),
+            status_code=upstream.status,
+            media_type=upstream.headers.get("Content-Type", "video/mp4"),
+            headers=response_headers,
+        )
