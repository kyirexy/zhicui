+        finally:
+            upstream.release()
+            await session.close()
+
+    return StreamingResponse(
+        image_body(),
+        status_code=upstream.status,
+        media_type=content_type,
+        headers={
+            "Cache-Control": "private, max-age=1800",
+            "X-Content-Type-Options": "nosniff",
