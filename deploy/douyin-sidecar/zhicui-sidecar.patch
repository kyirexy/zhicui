+            "has_more": True,
+            "max_cursor": 1,
+        },
+        {
+            "items": [
+                {"aweme_id": "three", "desc": "three"},
+                {"aweme_id": "four", "desc": "four"},
+            ],
+            "has_more": False,
+            "max_cursor": 2,
+        },
+    ]
+
+    class PagedAPIClient:
+        def __init__(self, *_args, **_kwargs):
+            self.page_index = 0
+
+        async def __aenter__(self):
+            return self
+
+        async def __aexit__(self, *_args):
+            return None
+
+        async def get_user_collection(self, *_args, **_kwargs):
+            page = pages[self.page_index]
+            self.page_index += 1
+            return page
+
+        get_user_like = get_user_collection
+        get_user_post = get_user_collection
+
+    monkeypatch.setattr(server_app, "DouyinAPIClient", PagedAPIClient)
+    snapshots = []
+
+    result = await server_app._fetch_library_metadata(
+        deps,
+        "collection",
+        5,
+        progress_callback=lambda processed, target: snapshots.append(
+            (processed, target)
+        ),
+    )
+
+    assert snapshots == [(2, 5), (4, 5)]
+    assert result == {"total": 4, "success": 4, "failed": 0, "skipped": 0}
