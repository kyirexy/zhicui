+            return {
+                "items": selected,
+                "next_cursor": f"browser:{next_offset}" if browser_has_more else None,
+                "has_more": browser_has_more,
+                "total_count": len(browser_items) if not state.get("needs_action") else None,
+                "complete": not browser_has_more and not state.get("needs_action"),
+                "needs_action": state.get("needs_action"),
+            }
+        return {
+            "items": safe_page,
+            "next_cursor": str(next_cursor) if has_more else None,
+            "has_more": has_more,
+            "total_count": len(seen_ids) if not has_more else None,
+            "complete": not has_more,
+            "needs_action": None,
+        }
