+            context_options: Dict[str, Any] = {"locale": "zh-CN"}
+            if browser_user_visible:
+                context_options["no_viewport"] = True
+            else:
+                context_options["viewport"] = {"width": 1280, "height": 800}
+            context = await browser_instance.new_context(**context_options)
