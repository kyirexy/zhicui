+    padding: 18px;
+    margin-bottom: 18px;
+    backdrop-filter: blur(8px);
+  }
+  .card h2 { margin: 0 0 14px; font-size: 15px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
+  .card h2 .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
+  .card h2 .meta { margin-left: auto; font-size: 12px; color: var(--muted); font-weight: 400; }
+  label { display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px; }
+  input[type=text], input[type=number], textarea, select {
+    width: 100%;
+    background: var(--bg-soft);
+    border: 1px solid var(--card-border);
+    color: var(--fg);
+    border-radius: 8px;
+    padding: 10px 12px;
+    font-size: 13px;
+    font-family: inherit;
+    outline: none;
+  }
+  input:focus, textarea:focus, select:focus { border-color: var(--accent); }
+  textarea { min-height: 64px; resize: vertical; font-family: ui-monospace, "SF Mono", Consolas, monospace; font-size: 12px; }
+  .row { display: flex; gap: 10px; flex-wrap: wrap; }
+  .row > * { flex: 1; min-width: 120px; }
+  .row .narrow { flex: 0 0 140px; }
+  button {
+    background: var(--accent);
+    color: #06231a;
+    border: none;
+    border-radius: 8px;
+    padding: 10px 16px;
+    font-size: 13px;
+    font-weight: 600;
+    cursor: pointer;
+    font-family: inherit;
+    transition: opacity .15s, transform .05s;
+  }
+  button:hover { opacity: .9; }
+  button:active { transform: translateY(1px); }
+  button.ghost { background: transparent; color: var(--fg); border: 1px solid var(--card-border); }
+  button.ghost:hover { border-color: var(--accent); color: var(--accent); }
+  button:disabled { opacity: .5; cursor: not-allowed; }
+  .status { font-size: 13px; margin-top: 10px; }
+  .status .ok { color: var(--accent); }
+  .status .bad { color: var(--danger); }
+  .status .warn { color: var(--warn); }
+  .hint { font-size: 12px; color: var(--muted); margin-top: 8px; line-height: 1.6; }
+  .hint code { background: var(--bg-soft); padding: 1px 5px; border-radius: 4px; color: var(--accent); font-size: 11px; }
+
+  /* 作品列表 */
+  .item {
+    border: 1px solid var(--card-border);
+    border-radius: 10px;
+    padding: 12px;
+    margin-bottom: 10px;
+    background: var(--bg-soft);
+    display: flex;
+    gap: 12px;
+    align-items: flex-start;
+  }
+  .item-cover { flex: 0 0 100px; }
+  .item-cover img { width: 100px; height: 132px; object-fit: cover; border-radius: 8px; background: var(--card); display: block; }
+  .item-body { flex: 1; min-width: 0; }
+  .item-head { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--muted); margin-bottom: 6px; flex-wrap: wrap; }
+  .item-head .author { color: var(--accent); }
+  .item-desc { font-size: 14px; line-height: 1.55; color: var(--fg); white-space: pre-wrap; word-break: break-word; }
+  .item-files { margin-top: 8px; display: flex; gap: 8px; flex-wrap: wrap; }
+  .item-files a {
+    font-size: 12px; color: var(--accent); text-decoration: none;
+    border: 1px solid var(--accent-soft); padding: 3px 10px; border-radius: 6px;
+    background: var(--accent-soft);
+  }
+  .item-files a:hover { background: var(--accent); color: #06231a; }
+  .pill { font-size: 11px; padding: 2px 8px; border-radius: 999px; background: var(--card); color: var(--muted); }
+  .empty { text-align: center; color: var(--muted); font-size: 13px; padding: 24px; }
+
+  /* 任务表 */
+  table { width: 100%; border-collapse: collapse; font-size: 12px; }
+  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--card-border); }
+  th { color: var(--muted); font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; }
+  td.mono { font-family: ui-monospace, "SF Mono", Consolas, monospace; font-size: 11px; color: var(--muted); }
+  .pill.pending { background: rgba(245,158,11,.15); color: var(--warn); }
+  .pill.running { background: var(--accent-soft); color: var(--accent); }
+  .pill.success { background: rgba(16,185,129,.18); color: var(--accent); }
+  .pill.failed { background: rgba(239,68,68,.15); color: var(--danger); }
+  .err { color: var(--danger); font-size: 12px; margin-top: 6px; word-break: break-all; }
+  .hidden { display: none !important; }
+</style>
+</head>
+<body>
+<div class="wrap">
+  <header>
+    <h1>抖音下载器</h1>
+    <span class="badge">Web 控制台</span>
+    <span class="sub">扫码登录 → 自动采集 → 文案 + 视频列表</span>
+  </header>
+
+  <!-- Cookie 区 -->
+  <section class="card">
+    <h2><span class="dot"></span> 第 1 步 · 登录抖音</h2>
+    <div class="status" id="cookieStatus">加载中…</div>
+    <div class="row" style="margin-top:12px">
+      <button id="scanBtn" onclick="startScan()">扫码登录自动获取</button>
+      <button class="ghost" id="toggleManualBtn" onclick="toggleManual()">手动粘贴 cookie</button>
+    </div>
+    <div id="manualBox" class="hidden" style="margin-top:12px">
+      <textarea id="cookieInput" placeholder="msToken=xxx; ttwid=yyy; odin_tt=zzz; passport_csrf_token=...; sid_guard=..."></textarea>
+      <div class="row" style="margin-top:8px"><button onclick="saveCookie()">保存 cookie</button></div>
+    </div>
+    <div class="status" id="scanStatus"></div>
+    <div class="hint">点「扫码登录」会启动安全登录任务；本机模式会弹出浏览器，服务器模式由知萃页面展示二维码。扫码成功后自动保存登录状态，<b>无需手动操作</b>。</div>
+  </section>
+
+  <!-- 采集 + 作品列表 -->
+  <section class="card">
+    <h2><span class="dot"></span> 第 2 步 · 我的收藏 <span class="meta" id="itemsMeta"></span></h2>
+    <div class="row" style="margin-bottom:12px">
+      <div>
+        <label>采集内容</label>
+        <select id="modeInput">
+          <option value="collection">collection — 全部收藏（包含未分组）</option>
+          <option value="like">like — 自己喜欢的作品（点过红心的）</option>
+          <option value="collect">collect — 手动建立的收藏夹</option>
+          <option value="post">post — 自己主页发布</option>
+        </select>
+      </div>
+      <div class="narrow">
+        <label>数量（0 = 全部）</label>
+        <input type="number" id="countInput" value="30" min="0" />
+      </div>
+      <div class="narrow" style="flex:0 0 auto; align-self:flex-end">
+        <button id="collectBtn" onclick="autoCollect()">开始采集</button>
+      </div>
+    </div>
+    <div class="status" id="collectStatus"></div>
+    <div id="itemsList" style="margin-top:14px"><div class="empty">登录后自动采集，作品会列在这里</div></div>
+  </section>
+
+  <!-- 手动下载 -->
+  <section class="card">
+    <h2><span class="dot"></span> 手动下载（单链接）</h2>
+    <label>主页 / 作品链接</label>
+    <input type="text" id="urlInput" placeholder="https://www.douyin.com/user/MS4wLjABAAAA..." />
+    <div class="row" style="margin-top:10px">
+      <div>
+        <label>模式</label>
+        <select id="manualMode">
+          <option value="post">post</option>
+          <option value="like">like</option>
+          <option value="collection">collection（全部收藏）</option>
+          <option value="collect">collect</option>
+          <option value="collectmix">collectmix</option>
+          <option value="mix">mix</option>
+          <option value="music">music</option>
+        </select>
+      </div>
+      <div class="narrow">
+        <label>数量（0 = 全部）</label>
+        <input type="number" id="manualCount" value="0" min="0" />
+      </div>
+    </div>
+    <div class="row" style="margin-top:12px"><button onclick="startCrawl()">开始下载</button><span class="hint" style="align-self:center" id="crawlMsg"></span></div>
+    <div class="err" id="crawlErr"></div>
+  </section>
+
+  <!-- 任务列表 -->
+  <section class="card">
+    <h2><span class="dot"></span> 任务列表 <span class="meta" id="jobsMeta"></span></h2>
+    <div id="jobsList"><div class="empty">暂无任务</div></div>
+  </section>
+</div>
+
+<script>
+const $ = (id) => document.getElementById(id);
+async function json(path, opts) {
+  const res = await fetch(path, { headers: { 'Content-Type': 'application/json' }, ...opts });
+  let data = null; try { data = await res.json(); } catch {}
+  if (!res.ok) throw new Error((data && (data.detail || data.error)) || `HTTP ${res.status}`);
+  return data;
+}
+function encodePath(p) { return (p || '').split('/').map(encodeURIComponent).join('/'); }
+
+// ---- cookie ----
+async function loadCookies() {
+  try {
+    const d = await json('/api/v1/cookies');
+    const valid = d.valid ? '<span class="ok">✓ 已登录</span>' : '<span class="bad">✗ 未登录</span>';
+    const names = new Set(d.cookie_names || []);
+    const missing = ['ttwid','odin_tt','passport_csrf_token','sid_guard'].filter(k => !names.has(k));
+    $('cookieStatus').innerHTML = `${valid} · ${d.count} 条 cookie` + (missing.length && !d.valid ? ` · <span class="warn">缺 ${missing.join(', ')}</span>` : '');
+    return d.valid;
+  } catch (e) {
+    $('cookieStatus').innerHTML = `<span class="bad">读取失败: ${e.message}</span>`;
+    return false;
+  }
+}
+function toggleManual() { $('manualBox').classList.toggle('hidden'); }
+async function saveCookie() {
+  const cookie = $('cookieInput').value.trim();
+  if (!cookie) { alert('请粘贴 cookie'); return; }
+  try {
+    const d = await json('/api/v1/cookies', { method: 'POST', body: JSON.stringify({ cookie }) });
+    $('cookieStatus').innerHTML = d.valid ? `<span class="ok">✓ 已登录</span> · ${d.count} 条 cookie` : `<span class="bad">✗ 缺关键字段</span> · ${d.count} 条`;
+  } catch (e) { alert('保存失败: ' + e.message); }
+}
+
+// ---- 扫码 ----
+let scanPoll = null;
+async function startScan() {
+  const btn = $('scanBtn'); btn.disabled = true;
+  $('scanStatus').innerHTML = '<span class="warn">正在启动浏览器…</span>';
+  try {
+    await json('/api/v1/fetch-cookie', { method: 'POST', body: JSON.stringify({}) });
+    $('scanStatus').innerHTML = '<span class="warn">浏览器已弹出，请用抖音 App 扫码登录（登录后自动提取）</span>';
+    scanPoll = setInterval(pollScan, 2000);
+  } catch (e) {
+    $('scanStatus').innerHTML = `<span class="bad">启动失败: ${e.message}</span>`;
+    btn.disabled = false;
+  }
+}
+async function pollScan() {
+  try {
+    const s = await json('/api/v1/fetch-cookie');
+    if (s.running) { $('scanStatus').innerHTML = `<span class="warn">${s.message || '等待扫码…'}</span>`; return; }
+    clearInterval(scanPoll); scanPoll = null;
+    $('scanBtn').disabled = false;
+    if (s.error) {
+      $('scanStatus').innerHTML = `<span class="bad">失败: ${s.error}</span>`;
+    } else {
+      $('scanStatus').innerHTML = `<span class="ok">✓ ${s.message || '登录成功'} — 下面选数量点「开始采集」</span>`;
+      loadCookies();
+    }
+  } catch (e) {
+    clearInterval(scanPoll); scanPoll = null;
+    $('scanBtn').disabled = false;
+    $('scanStatus').innerHTML = `<span class="bad">轮询失败: ${e.message}</span>`;
+  }
+}
+
+// ---- 自动采集 ----
+let autoCollecting = false;
+async function maybeAutoCollect() {
+  // 扫码/手动登录成功后自动触发一次采集（默认 collection 30 条）
+  if (autoCollecting) return;
+  autoCollecting = true;
+  await autoCollect(true);
+}
+async function autoCollect(isAuto) {
+  const mode = $('modeInput').value;
+  const count = parseInt($('countInput').value, 10);
+  $('collectStatus').innerHTML = '<span class="warn">提交采集任务…</span>';
+  $('collectBtn').disabled = true;
+  try {
+    const d = await json('/api/v1/auto-collect', {
+      method: 'POST', body: JSON.stringify({ mode, count: isNaN(count) ? 30 : count }),
+    });
+    $('collectStatus').innerHTML = `<span class="warn">采集中… job=${d.job_id}（模式 ${mode}，${isNaN(count) ? 30 : count} 条）</span>`;
+  } catch (e) {
+    $('collectStatus').innerHTML = `<span class="bad">提交失败: ${e.message}</span>`;
+  } finally {
+    $('collectBtn').disabled = false;
+  }
+}
+
+// ---- 作品列表 ----
+async function loadItems() {
+  try {
+    const d = await json('/api/v1/items');
+    const items = d.items || [];
+    $('itemsMeta').textContent = items.length ? `${items.length} 条` : '';
+    if (!items.length) {
+      $('itemsList').innerHTML = '<div class="empty">还没有作品，登录后点「开始采集」</div>';
+      return;
+    }
+    $('itemsList').innerHTML = items.map(it => {
+      const desc = (it.desc || '(无文案)').trim();
+      const files = it.file_paths || [];
+      const cover = files.find(f => /\.(jpg|jpeg|png|webp)$/i.test(f));
+      const coverHtml = cover
+        ? `<div class="item-cover"><img src="/files/${encodePath(cover)}" loading="lazy" onerror="this.parentNode.style.display='none'"></div>`
+        : '';
+      const links = files.filter(f => /\.(mp4|mp3)$/i.test(f)).slice(0, 4).map(f => {
+        const isVideo = /\.mp4$/i.test(f);
+        const label = isVideo ? '▶ 播放/下载视频' : '🎵 原声';
+        return `<a href="/files/${encodePath(f)}" target="_blank" download>${label}</a>`;
+      }).join('');
+      const date = (it.date || '').slice(0, 10);
+      return `<div class="item">${coverHtml}
+        <div class="item-body">
+          <div class="item-head"><span>${date}</span><span class="author">@${it.author_name || ''}</span><span class="pill">${it.media_type || ''}</span></div>
+          <div class="item-desc">${escapeHtml(desc)}</div>
+          <div class="item-files">${links}</div>
+        </div>
+      </div>`;
+    }).join('');
+    return d;
+  } catch (e) {
+    $('itemsList').innerHTML = `<div class="empty">加载失败: ${e.message}</div>`;
+    return { count: 0 };
+  }
+}
+function escapeHtml(s) { return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
+
+// ---- 手动下载 ----
+async function startCrawl() {
+  const url = $('urlInput').value.trim();
+  const mode = $('manualMode').value;
+  const count = parseInt($('manualCount').value, 10);
+  $('crawlErr').textContent = '';
+  if (!url) { $('crawlErr').textContent = '请填写链接'; return; }
+  $('crawlMsg').textContent = '提交中…';
+  try {
+    const d = await json('/api/v1/crawl', { method: 'POST', body: JSON.stringify({ url, mode, count: isNaN(count) ? 0 : count }) });
+    $('crawlMsg').textContent = `已提交 job=${d.job_id}`;
+    loadJobs();
+  } catch (e) { $('crawlErr').textContent = '提交失败: ' + e.message; $('crawlMsg').textContent = ''; }
+}
+
+// ---- 任务列表 ----
+async function loadJobs() {
+  try {
+    const d = await json('/api/v1/jobs');
+    const jobs = (d.jobs || []).slice().reverse();
+    $('jobsMeta').textContent = jobs.length ? `${jobs.length} 个` : '';
+    if (!jobs.length) { $('jobsList').innerHTML = '<div class="empty">暂无任务</div>'; return; }
+    $('jobsList').innerHTML = `<table><thead><tr><th>状态</th><th>模式</th><th>链接</th><th>结果</th><th>job_id</th></tr></thead><tbody>${jobs.map(j => `
+      <tr><td><span class="pill ${j.status}">${j.status}</span></td><td>${j.mode || '-'}</td>
+      <td class="mono" title="${j.url}">${shortUrl(j.url)}</td>
+      <td>${j.total ? `<b>${j.success}</b>/${j.total} 成功 · <b>${j.failed}</b> 失败` : (j.status === 'failed' ? `<span class="bad">${j.error || '失败'}</span>` : '—')}</td>
+      <td class="mono">${j.job_id}</td></tr>`).join('')}</tbody></table>`;
+  } catch (e) { $('jobsList').innerHTML = `<div class="empty">加载失败: ${e.message}</div>`; }
+}
+function shortUrl(u) { return u && u.length > 38 ? u.slice(0, 36) + '…' : (u || '-'); }
+
+// ---- init ----
+(async () => {
+  await loadCookies();
+  await loadItems();
+  loadJobs();
+})();
+setInterval(loadJobs, 2500);
+setInterval(loadItems, 4000);
+setInterval(loadCookies, 20000);
+</script>
+</body>
+</html>
