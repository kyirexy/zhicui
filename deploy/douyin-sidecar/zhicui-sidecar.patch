+async def _secure_sec_uid_from_session(deps: "_SessionDeps") -> str:
+    """解析并缓存 like 探测所需的真 sec_uid；失败时安全回退为空串。
+
+    缓存文件放在会话库根：真 sec_uid 不新鲜无所谓，探测最终要靠
+    favorite 接口实际返回判断，缓存只是减少一次 profile 请求。
+    """
+    cache_path = deps.sec_uid_cache_path
+    try:
+        existing = cache_path.read_text(encoding="utf-8").strip()
+        if existing:
+            logger.info("like-probe: reuse cached sec_uid scope=%s", deps.scope)
+            return existing
+    except OSError:
+        pass
+
+    sec_uid = await _safe_resolve_sec_uid(deps)
+    if sec_uid:
+        try:
+            cache_path.parent.mkdir(parents=True, exist_ok=True)
+            cache_path.write_text(sec_uid, encoding="utf-8")
+            logger.info("like-probe: resolved and cached sec_uid scope=%s", deps.scope)
+        except OSError as exc:
+            logger.warning("like-probe: cache sec_uid failed scope=%s: %s", deps.scope, exc)
+    return sec_uid
+
