+def _crop_qr_from_screenshot(screenshot: bytes) -> Optional[bytes]:
+    """使用 OpenCV 定位并裁剪二维码；无法解码时不返回页面截图。"""
+    try:
+        import cv2
+        import numpy as np
+    except ImportError:
+        return None
+    if not screenshot or len(screenshot) > 8 * 1024 * 1024:
+        return None
+    matrix = cv2.imdecode(
+        np.frombuffer(screenshot, dtype=np.uint8),
+        cv2.IMREAD_COLOR,
+    )
+    if matrix is None:
+        return None
+    detector = cv2.QRCodeDetector()
+    _, points, _ = detector.detectAndDecode(matrix)
+    if points is None:
+        detected, points = detector.detect(matrix)
+        if not detected or points is None:
+            return None
+    flattened = points.reshape(-1, 2)
+    x1 = max(0, int(flattened[:, 0].min()) - 16)
+    y1 = max(0, int(flattened[:, 1].min()) - 16)
+    x2 = min(matrix.shape[1], int(flattened[:, 0].max()) + 17)
+    y2 = min(matrix.shape[0], int(flattened[:, 1].max()) + 17)
+    if x2 - x1 < 100 or y2 - y1 < 100:
+        return None
+    crop = matrix[y1:y2, x1:x2]
+    encoded, buffer = cv2.imencode(".png", crop)
+    if not encoded:
+        return None
+    image = buffer.tobytes()
+    if not (500 <= len(image) <= MAX_QR_IMAGE_BYTES):
+        return None
+    return image
