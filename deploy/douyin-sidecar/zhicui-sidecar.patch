+      $('scanStatus').innerHTML = `<span class="bad">失败: ${s.error}</span>`;
+    } else {
+      $('scanStatus').innerHTML = `<span class="ok">✓ ${s.message || '登录成功'} — 下面选数量点「开始采集」</span>`;
+      loadCookies();
+    }
+  } catch (e) {
+    clearInterval(scanPoll); scanPoll = null;
+    $('scanBtn').disabled = false;
+    $('scanStatus').innerHTML = `<span class="bad">轮询失败: ${e.message}</span>`;
+  }
+}
+
+// ---- 自动采集 ----
+let autoCollecting = false;
+async function maybeAutoCollect() {
+  // 扫码/手动登录成功后自动触发一次采集（默认 collection 30 条）
+  if (autoCollecting) return;
+  autoCollecting = true;
+  await autoCollect(true);
+}
+async function autoCollect(isAuto) {
+  const mode = $('modeInput').value;
+  const count = parseInt($('countInput').value, 10);
+  $('collectStatus').innerHTML = '<span class="warn">提交采集任务…</span>';
+  $('collectBtn').disabled = true;
+  try {
+    const d = await json('/api/v1/auto-collect', {
+      method: 'POST', body: JSON.stringify({ mode, count: isNaN(count) ? 30 : count }),
+    });
+    $('collectStatus').innerHTML = `<span class="warn">采集中… job=${d.job_id}（模式 ${mode}，${isNaN(count) ? 30 : count} 条）</span>`;
+  } catch (e) {
+    $('collectStatus').innerHTML = `<span class="bad">提交失败: ${e.message}</span>`;
+  } finally {
+    $('collectBtn').disabled = false;
+  }
+}
+
+// ---- 作品列表 ----
+async function loadItems() {
+  try {
+    const d = await json('/api/v1/items');
+    const items = d.items || [];
+    $('itemsMeta').textContent = items.length ? `${items.length} 条` : '';
+    if (!items.length) {
+      $('itemsList').innerHTML = '<div class="empty">还没有作品，登录后点「开始采集」</div>';
+      return;
+    }
+    $('itemsList').innerHTML = items.map(it => {
+      const desc = (it.desc || '(无文案)').trim();
+      const files = it.file_paths || [];
+      const cover = files.find(f => /\.(jpg|jpeg|png|webp)$/i.test(f));
+      const coverHtml = cover
+        ? `<div class="item-cover"><img src="/files/${encodePath(cover)}" loading="lazy" onerror="this.parentNode.style.display='none'"></div>`
+        : '';
+      const links = files.filter(f => /\.(mp4|mp3)$/i.test(f)).slice(0, 4).map(f => {
+        const isVideo = /\.mp4$/i.test(f);
+        const label = isVideo ? '▶ 播放/下载视频' : '🎵 原声';
+        return `<a href="/files/${encodePath(f)}" target="_blank" download>${label}</a>`;
+      }).join('');
+      const date = (it.date || '').slice(0, 10);
+      return `<div class="item">${coverHtml}
+        <div class="item-body">
+          <div class="item-head"><span>${date}</span><span class="author">@${it.author_name || ''}</span><span class="pill">${it.media_type || ''}</span></div>
+          <div class="item-desc">${escapeHtml(desc)}</div>
+          <div class="item-files">${links}</div>
+        </div>
+      </div>`;
+    }).join('');
+    return d;
+  } catch (e) {
+    $('itemsList').innerHTML = `<div class="empty">加载失败: ${e.message}</div>`;
+    return { count: 0 };
+  }
+}
+function escapeHtml(s) { return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
+
+// ---- 手动下载 ----
+async function startCrawl() {
+  const url = $('urlInput').value.trim();
+  const mode = $('manualMode').value;
+  const count = parseInt($('manualCount').value, 10);
+  $('crawlErr').textContent = '';
+  if (!url) { $('crawlErr').textContent = '请填写链接'; return; }
+  $('crawlMsg').textContent = '提交中…';
+  try {
+    const d = await json('/api/v1/crawl', { method: 'POST', body: JSON.stringify({ url, mode, count: isNaN(count) ? 0 : count }) });
+    $('crawlMsg').textContent = `已提交 job=${d.job_id}`;
+    loadJobs();
+  } catch (e) { $('crawlErr').textContent = '提交失败: ' + e.message; $('crawlMsg').textContent = ''; }
+}
+
+// ---- 任务列表 ----
+async function loadJobs() {
+  try {
+    const d = await json('/api/v1/jobs');
+    const jobs = (d.jobs || []).slice().reverse();
+    $('jobsMeta').textContent = jobs.length ? `${jobs.length} 个` : '';
+    if (!jobs.length) { $('jobsList').innerHTML = '<div class="empty">暂无任务</div>'; return; }
+    $('jobsList').innerHTML = `<table><thead><tr><th>状态</th><th>模式</th><th>链接</th><th>结果</th><th>job_id</th></tr></thead><tbody>${jobs.map(j => `
+      <tr><td><span class="pill ${j.status}">${j.status}</span></td><td>${j.mode || '-'}</td>
+      <td class="mono" title="${j.url}">${shortUrl(j.url)}</td>
+      <td>${j.total ? `<b>${j.success}</b>/${j.total} 成功 · <b>${j.failed}</b> 失败` : (j.status === 'failed' ? `<span class="bad">${j.error || '失败'}</span>` : '—')}</td>
+      <td class="mono">${j.job_id}</td></tr>`).join('')}</tbody></table>`;
+  } catch (e) { $('jobsList').innerHTML = `<div class="empty">加载失败: ${e.message}</div>`; }
+}
+function shortUrl(u) { return u && u.length > 38 ? u.slice(0, 36) + '…' : (u || '-'); }
+
+// ---- init ----
+(async () => {
+  loadProbe();
+  await loadCookies();
+  await loadItems();
+  loadJobs();
+})();
+setInterval(loadJobs, 2500);
+setInterval(loadItems, 4000);
+setInterval(loadCookies, 20000);
+setInterval(loadProbe, 10000);
+</script>
+</body>
+</html>
