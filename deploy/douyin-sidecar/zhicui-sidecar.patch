+    @app.get("/api/v1/media/{aweme_id}")
+    async def stream_media(
+        aweme_id: str,
+        request: Request,
+        scope: str = Depends(_session_scope),
+    ) -> StreamingResponse:
+        """即时代理当前作品；响应结束即释放连接，永不落盘。"""
+        scoped = deps.session(scope)
+        clean_id = aweme_id.strip()
+        if not clean_id or len(clean_id) > 128 or not clean_id.replace("_", "").replace("-", "").isalnum():
+            raise HTTPException(status_code=400, detail="作品标识无效")
+
+        async def resolve_media(*, force: bool = False) -> tuple[str, Dict[str, str]]:
+            now = time.monotonic()
+            cached = scoped.media_stream_cache.get(clean_id)
+            if not force and cached and cached[0] > now:
+                return cached[1], dict(cached[2])
+            async with scoped.media_stream_lock:
+                cached = scoped.media_stream_cache.get(clean_id)
+                if not force and cached and cached[0] > time.monotonic():
+                    return cached[1], dict(cached[2])
+                async with DouyinAPIClient(
+                    scoped.cookie_manager.get_cookies(),
+                    proxy=deps.config.get("proxy"),
+                ) as api_client:
+                    detail = await api_client.get_video_detail(clean_id)
+                    if not detail:
+                        raise HTTPException(status_code=404, detail="未找到作品")
+                    downloader = DownloaderFactory.create(
+                        "video",
+                        scoped.config,
+                        api_client,
+                        scoped.file_manager,
+                        scoped.cookie_manager,
