+def _creator_id_from_profile_url(profile_url: str) -> str:
+    parsed = urlparse(str(profile_url or "").strip())
+    if (
+        parsed.scheme not in {"http", "https"}
+        or (parsed.hostname or "").lower() not in {"www.douyin.com", "douyin.com"}
+    ):
+        return ""
+    segments = [segment for segment in parsed.path.split("/") if segment]
+    if len(segments) < 2 or segments[0] != "user":
+        return ""
+    creator_id = segments[1]
+    if not re.fullmatch(r"[A-Za-z0-9_-]{12,192}", creator_id):
+        return ""
+    return creator_id
+
