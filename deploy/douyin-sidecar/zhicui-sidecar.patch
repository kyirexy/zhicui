+    @app.get("/api/v1/media/{aweme_id}")
+    async def stream_media(
+        aweme_id: str,
+        request: Request,
+        scope: str = Depends(_session_scope),
+    ) -> StreamingResponse:
+        """即时代理当前作品；响应结束即释放连接，永不落盘。"""
+        scoped = deps.session(scope)
+        clean_id = aweme_id.strip()
+        if not clean_id or len(clean_id) > 128 or not clean_id.replace("_", "").replace("-", "").isalnum():
+            raise HTTPException(status_code=400, detail="作品标识无效")
+
+        async def resolve_media(*, force: bool = False) -> tuple[str, Dict[str, str]]:
+            now = time.monotonic()
+            cached = scoped.media_stream_cache.get(clean_id)
+            if not force and cached and cached[0] > now:
+                return cached[1], dict(cached[2])
+            # 只对同一作品串行；不同作品并行解析，避免全局锁拖慢批量转写。
+            async with scoped.media_stream_locks_guard:
+                lock = scoped.media_stream_locks.get(clean_id)
+                if lock is None:
+                    lock = asyncio.Lock()
+                    scoped.media_stream_locks[clean_id] = lock
+            async with lock:
+                cached = scoped.media_stream_cache.get(clean_id)
+                if not force and cached and cached[0] > time.monotonic():
+                    return cached[1], dict(cached[2])
+                async with scoped.media_resolve_semaphore:
+                    async with DouyinAPIClient(
+                        scoped.cookie_manager.get_cookies(),
+                        proxy=deps.config.get("proxy"),
+                    ) as api_client:
+                        detail = await api_client.get_video_detail(clean_id)
+                        if not detail:
+                            raise HTTPException(status_code=404, detail="未找到作品")
+                        downloader = DownloaderFactory.create(
+                            "video",
+                            scoped.config,
+                            api_client,
+                            scoped.file_manager,
+                            scoped.cookie_manager,
+                            None,
+                            scoped.rate_limiter,
+                            scoped.retry_handler,
+                            scoped.queue_manager,
+                            progress_reporter=None,
+                        )
+                        media_info = (
+                            downloader._build_no_watermark_url(detail)
+                            if downloader
+                            else None
+                        )
+                    if not media_info:
+                        raise HTTPException(status_code=422, detail="该作品没有可播放视频")
+                    target_url, target_headers = media_info
+                scoped.media_stream_cache[clean_id] = (
+                    time.monotonic() + MEDIA_STREAM_CACHE_TTL_SECONDS,
+                    target_url,
+                    dict(target_headers),
+                )
+                return target_url, dict(target_headers)
+
+        target_url, target_headers = await resolve_media()
+        range_header = request.headers.get("range")
+        if range_header:
+            target_headers["Range"] = range_header
+        session = aiohttp.ClientSession()
+        upstream = None
+        try:
+            for attempt in range(2):
+                upstream = await session.get(
+                    target_url,
+                    headers=target_headers,
+                    proxy=deps.config.get("proxy") or None,
+                    timeout=aiohttp.ClientTimeout(total=600),
+                )
+                if upstream.status < 400:
+                    break
+                detail_text = await upstream.text()
+                upstream.release()
+                if attempt == 0:
+                    scoped.media_stream_cache.pop(clean_id, None)
+                    target_url, target_headers = await resolve_media(force=True)
+                    if range_header:
+                        target_headers["Range"] = range_header
+                    continue
+                raise HTTPException(
+                    status_code=502,
+                    detail=f"抖音媒体流返回 {upstream.status}: {detail_text[:120]}",
+                )
+        except Exception:
+            if upstream is not None:
+                upstream.release()
+            if not session.closed:
+                await session.close()
