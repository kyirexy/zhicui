+@pytest.mark.asyncio
+async def test_login_browser_workers_are_globally_bounded_and_scoped(
+    tmp_path,
+    monkeypatch,
+):
+    config = ConfigLoader(None)
+    config.update(
+        path=str(tmp_path),
+        server={"login_browser_concurrency": 2},
+    )
+    app = build_app(config)
+    owner = app.state.deps
+    scopes = [
+        "bounded-login-scope-a-123456789012",
+        "bounded-login-scope-b-123456789012",
+        "bounded-login-scope-c-123456789012",
+    ]
+    sessions = [owner.session(scope) for scope in scopes]
+    release_workers = threading.Event()
+    state_lock = threading.Lock()
+    active_scopes = set()
+    max_active = 0
+
+    async def fake_worker(deps, browser):
+        nonlocal max_active
+        with state_lock:
+            active_scopes.add(deps.scope)
+            max_active = max(max_active, len(active_scopes))
+        try:
+            while not release_workers.is_set():
+                await asyncio.sleep(0.01)
+            return {"sessionid": f"session-for-{deps.scope}"}
+        finally:
+            with state_lock:
+                active_scopes.discard(deps.scope)
+
+    monkeypatch.setattr(server_app, "_fetch_cookie_auto_worker", fake_worker)
+    tasks = [
+        asyncio.create_task(server_app._fetch_cookie_auto(session))
+        for session in sessions
+    ]
+    try:
+        for _ in range(100):
+            with state_lock:
+                active_count = len(active_scopes)
+            if active_count == 2:
+                break
+            await asyncio.sleep(0.01)
+
+        with state_lock:
+            assert len(active_scopes) == 2
+            assert max_active == 2
+        assert sum(
+            session.fetch_status["browser_mode"] == "queued"
+            for session in sessions
+        ) == 1
+    finally:
+        release_workers.set()
+
+    results = await asyncio.gather(*tasks)
+    assert all(server_app._has_authenticated_session(result) for result in results)
+    assert max_active == 2
+
+
+@pytest.mark.asyncio
+async def test_cancelling_queued_login_does_not_stop_active_scope(
+    tmp_path,
+    monkeypatch,
+):
+    config = ConfigLoader(None)
+    config.update(
+        path=str(tmp_path),
+        server={"login_browser_concurrency": 1},
+    )
+    app = build_app(config)
+    owner = app.state.deps
+    active = owner.session("active-login-scope-123456789012345")
+    queued = owner.session("queued-login-scope-123456789012345")
+    release_worker = threading.Event()
+
+    async def fake_worker(deps, browser):
+        while not release_worker.is_set():
+            await asyncio.sleep(0.01)
+        return {"sessionid": "private-session-value"}
+
+    monkeypatch.setattr(server_app, "_fetch_cookie_auto_worker", fake_worker)
+    active_task = asyncio.create_task(server_app._fetch_cookie_auto(active))
+    try:
+        for _ in range(100):
+            if active.fetch_worker_running:
+                break
+            await asyncio.sleep(0.01)
+        queued_task = asyncio.create_task(server_app._fetch_cookie_auto(queued))
+        for _ in range(100):
+            if queued.fetch_status["browser_mode"] == "queued":
+                break
+            await asyncio.sleep(0.01)
+
+        queued_task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await queued_task
+        assert active_task.done() is False
+        assert active.fetch_worker_running is True
+    finally:
+        release_worker.set()
+
+    result = await active_task
+    assert server_app._has_authenticated_session(result) is True
+
