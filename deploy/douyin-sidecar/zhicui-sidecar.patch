+def _probe_like_success(page: Dict[str, Any]) -> bool:
+    """判定单发 favorite 探测是否命中真实喜欢列表。
+
+    抖音风控不会总是显式 403：有时返回 200 空壳里放 ``www-hj`` 或
+    argus/verify 风险字段。只把「aweme_list 非空」当作成功，避免把
+    护航空响应误判为窗口打开。
+    """
+    if not isinstance(page, dict):
+        return False
+    items = page.get("items")
+    if not isinstance(items, list) or not items:
+        return False
+    raw = page.get("raw") if isinstance(page.get("raw"), dict) else {}
+    if "www-hj" in json.dumps(raw, ensure_ascii=False):
+        return False
+    risk = page.get("risk_flags") if isinstance(page.get("risk_flags"), dict) else {}
+    return not bool(risk.get("verify_page") or risk.get("login_tip"))
+
+
+def _probe_like_suspect_hint(page: Dict[str, Any]) -> str:
+    """从风控空响应中提取可读原因，用于日志通知；成功时返回空串。"""
+    if not isinstance(page, dict):
+        return "接口返回空"
+    raw = page.get("raw") if isinstance(page.get("raw"), dict) else {}
+    raw_text = json.dumps(raw, ensure_ascii=False)
+    if "www-hj" in raw_text:
+        return "被风控护航到 www-hj.douyin.com（200 空响应）"
+    for key in ("aweme_detail", "status_msg", "message", "filter_detail"):
+        value = raw.get(key)
+        if isinstance(value, dict):
+            text = str(value.get("url") or value.get("title") or value.get("msg") or "")
+            if text:
+                return text[:160]
+        if isinstance(value, str) and value.strip():
+            return value[:160]
+    try:
+        status_code = raw.get("status_code")
+    except AttributeError:
+        status_code = None
+    return f"接口状态 {status_code}" if status_code is not None else "接口返回空"
+
