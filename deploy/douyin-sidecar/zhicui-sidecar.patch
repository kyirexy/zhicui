+async def _browser_creator_catalog(
+    deps: "_SessionDeps",
+    api_client: DouyinAPIClient,
+    state: Dict[str, Any],
+    expected_count: int,
+) -> List[Dict[str, Any]]:
+    if state.get("browser_items") is not None:
+        return list(state["browser_items"])
+    if state.get("cancelled"):
+        raise asyncio.CancelledError()
+    browser_cfg = deps.config.get("browser_fallback", {}) or {}
+    if not browser_cfg.get("enabled", True):
+        state["needs_action"] = "risk_control"
+        state["browser_items"] = []
+        return []
+    ids = await api_client.collect_user_post_ids_via_browser(
+        str(state["creator_id"]),
+        expected_count=max(0, int(expected_count or 0)),
+        # Headless returns immediately on a captcha instead of waiting forever
+        # in the server's Xvfb. Zhicui then exposes a needs_action state.
+        headless=True,
+        max_scrolls=min(int(browser_cfg.get("max_scrolls", 240) or 240), 500),
+        idle_rounds=min(int(browser_cfg.get("idle_rounds", 8) or 8), 30),
+        wait_timeout_seconds=min(int(browser_cfg.get("wait_timeout_seconds", 180) or 180), 300),
+    )
+    captured = api_client.pop_browser_post_aweme_items()
+    safe_items: List[Dict[str, Any]] = []
+    for aweme_id in ids[:MAX_CATALOG_ITEMS]:
+        if state.get("cancelled"):
+            raise asyncio.CancelledError()
+        raw = captured.get(str(aweme_id))
+        if not raw:
+            await deps.rate_limiter.acquire()
+            raw = await api_client.get_video_detail(str(aweme_id), suppress_error=True)
+        if not isinstance(raw, dict):
+            continue
+        safe = _safe_creator_catalog_item(raw, len(safe_items))
+        if safe.get("aweme_id"):
+            safe_items.append(safe)
+    state["browser_items"] = safe_items
+    if not safe_items or (expected_count > 0 and len(safe_items) < expected_count):
+        state["needs_action"] = "verification"
+    return list(safe_items)
