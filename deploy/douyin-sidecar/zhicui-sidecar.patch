+        self.catalog_lock = asyncio.Lock()
+        self.media_stream_cache: Dict[
+            str,
+            tuple[float, str, Dict[str, str]],
+        ] = {}
+        # 每作品一把锁：不同作品的媒体 URL 解析可以完全并行，
+        # 只有同一作品并发请求时才串行（避免重复解析同一 URL）。
+        self.media_stream_locks: Dict[str, asyncio.Lock] = {}
+        self.media_stream_locks_guard = asyncio.Lock()
+        # 媒体解析（get_video_detail）的受控并发：全并行会瞬间打出几十个
+        # 详情请求触发反爬；8 并发在安全与速度之间平衡（≈7 倍于原串行）。
+        self.media_resolve_semaphore = asyncio.Semaphore(8)
+        self.fetch_status: Dict[str, Any] = {
+            "running": False,
+            "message": "",
+            "error": "",
+            "browser_opened": False,
+            "browser_mode": "idle",
+            "observed_cookie_count": 0,
+            "authenticated": False,
+        }
+        self.fetch_qr_image: Optional[bytes] = None
+        self.fetch_qr_digest = ""
+        self.fetch_qr_version = 0
+        self.fetch_task: Optional[asyncio.Task] = None
+        self.fetch_cancel_event = threading.Event()
+        self.fetch_worker_running = False
+        self.fetch_driver_process: Any = None
+        self.login_browser_semaphore = owner.login_browser_semaphore
+        # 喜欢低频自动探测状态：只在 sidecar 显式启用时运行。
+        self.probe_enabled = owner.auto_probe_enabled
+        self.probe_lock = asyncio.Lock()
+        self.probe_task: Optional[asyncio.Task] = None
+        self.probe_interval = owner.auto_probe_interval
+        self.probe_max_interval = owner.auto_probe_max_interval
+        self.probe_start_seconds = owner.auto_probe_start_seconds
+        self.probe_last_result = ""
+        self.probe_last_check_at = ""
+        self.probe_last_open_at = ""
+        self.probe_last_success_count = 0
+        self.action = ""
+        self.action_at = ""
+        # 收藏低频自动探测状态（与喜欢共用开关/最大间隔，但独立退避）。
+        self.probe_task_collection: Optional[asyncio.Task] = None
+        self.probe_interval_collection = owner.auto_probe_interval
+        self.probe_last_result_collection = ""
+        self.probe_last_check_at_collection = ""
+        self.probe_last_open_at_collection = ""
+        self.probe_last_success_count_collection = 0
+        self.action_collection = ""
+        self.action_at_collection = ""
+        self.collection_sync_lock = asyncio.Lock()
+        self.collection_failure_count = 0
+        self.collection_blocked_until = 0.0
+        self.collection_resilience_enabled = owner.collection_resilience_enabled
+        self.collection_cooldown_seconds = owner.collection_cooldown_seconds
+        self.collection_cooldown_cap_seconds = owner.collection_cooldown_cap_seconds
+        self.sec_uid_cache_path = Path(library_path) / SEC_UID_CACHE_FILENAME
+
+    def clear_qr(self) -> None:
+        self.fetch_qr_image = None
+        self.fetch_qr_digest = ""
+
+    def update_qr(self, image: bytes) -> bool:
+        if not image or len(image) > MAX_QR_IMAGE_BYTES:
+            return False
+        digest = hashlib.sha256(image).hexdigest()
+        if digest == self.fetch_qr_digest:
+            return False
+        self.fetch_qr_image = image
+        self.fetch_qr_digest = digest
+        self.fetch_qr_version += 1
+        return True
