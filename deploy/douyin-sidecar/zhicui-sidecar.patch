+async def _fetch_cookie_auto(
+    deps: "_SessionDeps",
+    browser: str = "chromium",
+) -> Dict[str, str]:
+    """Run Playwright outside the API loop so Douyin reloads cannot freeze status."""
+    loop = asyncio.get_running_loop()
