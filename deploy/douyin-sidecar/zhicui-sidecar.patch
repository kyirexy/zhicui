+    try:
+        async with DouyinAPIClient(
+            deps.cookie_manager.get_cookies(),
+            proxy=deps.config.get("proxy"),
+        ) as api_client:
+            return await _resolve_self_sec_uid(api_client)
+    except Exception as exc:
+        logger.warning("like-probe: resolve sec_uid failed scope=%s: %s", deps.scope, exc)
