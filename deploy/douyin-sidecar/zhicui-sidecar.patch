+    """
+    try:
+        from playwright.async_api import async_playwright
+    except ImportError as exc:
+        raise RuntimeError(
+            "Playwright 未安装：pip install playwright && python -m playwright install chromium"
+        ) from exc
+
+    async with async_playwright() as p:
+        transport = getattr(
+            getattr(getattr(p, "_impl_obj", None), "_connection", None),
+            "_transport",
+            None,
+        )
+        deps.fetch_driver_process = getattr(transport, "_proc", None)
+        browser_factory = getattr(p, browser, p.chromium)
+        configured_browser_mode = _configured_login_browser_mode()
+        headless = configured_browser_mode == "headless"
+        browser_user_visible = configured_browser_mode == "visible_chrome"
+        deps.fetch_status["message"] = "正在启动抖音安全登录窗口…"
+        launch_options: Dict[str, Any] = {
+            "headless": headless,
+            "timeout": 15000,
+        }
+        if browser == "chromium" and browser_user_visible:
+            # The user's installed Chrome is substantially more stable for an
+            # interactive verification page than Playwright's bundled build.
