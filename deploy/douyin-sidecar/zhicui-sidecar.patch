+    deps: "_SessionDeps",
+    mode: str,
+    aweme_ids: List[str],
+) -> Dict[str, Any]:
+    """原子合并来源顺序：本次快照在前，旧快照未覆盖部分保持原顺序。"""
+    clean_ids = _unique_aweme_ids(
+        [{"aweme_id": aweme_id} for aweme_id in aweme_ids],
+        MAX_SYNC_COUNT,
+    )
+    if not clean_ids:
+        return {"mode": mode, "count": 0, "synced_at": None}
+
+    async with deps.source_order_lock:
+        data = await _read_source_orders(deps.source_order_path)
+        modes = data["modes"]
+        previous = modes.get(mode)
+        previous_ids = previous.get("aweme_ids") if isinstance(previous, dict) else []
+        if not isinstance(previous_ids, list):
+            previous_ids = []
+        merged = clean_ids + [
+            str(aweme_id)
+            for aweme_id in previous_ids
+            if str(aweme_id) and str(aweme_id) not in clean_ids
+        ]
+        synced_at = _now_utc_iso()
+        modes[mode] = {
+            "aweme_ids": merged[:10000],
+            "synced_at": synced_at,
+        }
+        payload = json.dumps(data, ensure_ascii=False, indent=2)
+        temp_path = deps.source_order_path.with_suffix(".tmp")
+        async with aiofiles.open(temp_path, "w", encoding="utf-8") as file:
+            await file.write(payload)
+        loop = asyncio.get_running_loop()
+        await loop.run_in_executor(None, temp_path.replace, deps.source_order_path)
+        return {
+            "mode": mode,
+            "count": len(clean_ids),
+            "total_ranked": len(modes[mode]["aweme_ids"]),
+            "synced_at": synced_at,
+        }
+
+
+def _bounded_sync_count(count: Any) -> int:
+    """收藏同步允许 1–100 条，任何内部调用也不能绕过上限。"""
+    try:
+        parsed = int(count)
+    except (TypeError, ValueError):
+        return 50
+    return max(1, min(parsed, MAX_SYNC_COUNT))
+
+
+def _first_remote_url(value: Any) -> str:
+    if isinstance(value, str):
+        return value if value.startswith(("http://", "https://")) else ""
+    if not isinstance(value, dict):
+        return ""
+    urls = value.get("url_list")
+    if isinstance(urls, list):
+        for candidate in urls:
+            if isinstance(candidate, str) and candidate.startswith(("http://", "https://")):
+                return candidate
+    return ""
+
+
+def _remote_urls(value: Any) -> List[str]:
+    if isinstance(value, str):
+        return [value] if value.startswith(("http://", "https://")) else []
+    if not isinstance(value, dict):
+        return []
+    return [
+        candidate
+        for candidate in (value.get("url_list") or [])
+        if isinstance(candidate, str)
+        and candidate.startswith(("http://", "https://"))
+    ]
+
+
+def _catalog_record(
+    item: Dict[str, Any],
+    *,
+    mode: str,
+    source_rank: int,
+    synced_at: str,
+) -> Dict[str, Any]:
+    """只保留资料库展示/提取所需元数据，不持久化播放地址或 Cookie。"""
+    aweme_id = str(item.get("aweme_id") or "").strip()
+    author = item.get("author") if isinstance(item.get("author"), dict) else {}
+    video = item.get("video") if isinstance(item.get("video"), dict) else {}
+    images = item.get("images") if isinstance(item.get("images"), list) else []
+    if not images and isinstance(item.get("image_list"), list):
+        images = item["image_list"]
+    image_post_info = (
+        item.get("image_post_info")
+        if isinstance(item.get("image_post_info"), dict)
+        else {}
+    )
+    if not images and isinstance(image_post_info.get("images"), list):
+        images = image_post_info["images"]
+    gallery_images = list(dict.fromkeys(
+        image_url
+        for image_url in (_first_remote_url(image) for image in images)
+        if image_url
+    ))[:30]
+    cover_urls: List[str] = []
+    for cover_key in ("cover", "origin_cover", "dynamic_cover"):
+        cover_urls.extend(_remote_urls(video.get(cover_key)))
+    if not cover_urls and images:
+        cover_urls.extend(_remote_urls(images[0]))
+    cover_urls = list(dict.fromkeys(cover_urls))[:12]
+    cover_url = cover_urls[0] if cover_urls else ""
+
+    tags: List[str] = []
+    text_extra = item.get("text_extra")
+    if isinstance(text_extra, list):
+        for extra in text_extra:
+            if not isinstance(extra, dict):
+                continue
+            tag = str(extra.get("hashtag_name") or "").strip()
+            if tag and tag not in tags:
+                tags.append(tag)
+            if len(tags) >= 12:
+                break
+
+    publish_timestamp = item.get("create_time")
+    try:
+        publish_timestamp = int(publish_timestamp)
+    except (TypeError, ValueError):
+        publish_timestamp = None
+    return {
+        "aweme_id": aweme_id,
+        "desc": str(item.get("desc") or "").strip(),
+        "author_name": str(author.get("nickname") or "").strip(),
+        "media_type": "gallery" if images else "video",
+        "gallery_images": gallery_images,
+        "gallery_count": len(gallery_images),
+        "tags": tags,
+        "publish_timestamp": publish_timestamp,
+        "cover_url": cover_url,
+        "cover_urls": cover_urls,
+        "source_mode": mode,
+        "source_rank": source_rank,
+        "source_synced_at": synced_at,
+        "recorded_at": synced_at,
+        "file_paths": [],
+    }
+
+
+async def _read_library_catalog(path: Path) -> Dict[str, Any]:
+    if not path.exists():
+        return {"version": 1, "modes": {}}
+    try:
+        async with aiofiles.open(path, "r", encoding="utf-8") as file:
+            data = json.loads(await file.read())
+    except (OSError, json.JSONDecodeError):
+        return {"version": 1, "modes": {}}
+    modes = data.get("modes") if isinstance(data, dict) else None
+    return {"version": 1, "modes": modes if isinstance(modes, dict) else {}}
+
+
+async def _find_catalog_item(path: Path, aweme_id: str) -> Optional[Dict[str, Any]]:
+    catalog = await _read_library_catalog(path)
+    for snapshot in catalog["modes"].values():
+        if not isinstance(snapshot, dict):
+            continue
+        items = snapshot.get("items")
+        if not isinstance(items, list):
+            continue
+        for item in items:
+            if (
+                isinstance(item, dict)
+                and str(item.get("aweme_id") or "") == aweme_id
+            ):
+                return item
+    return None
+
+
+async def _stream_remote_image_candidates(
+    candidate_urls: List[str],
+    *,
+    proxy: Optional[str],
+) -> StreamingResponse:
+    # Douyin usually supplies p9/p6/p3 mirrors. Bound both the candidate count
+    # and each attempt so one stalled CDN cannot consume the backend's entire
+    # cover-proxy timeout before a healthy mirror is tried.
+    unique_urls = list(dict.fromkeys(candidate_urls))[:6]
+    if not unique_urls:
+        raise HTTPException(status_code=422, detail="该作品没有可用图片")
+    session = aiohttp.ClientSession()
+    upstream = None
+    content_type = "image/jpeg"
+    last_error = "所有候选图片均不可用"
+    request_headers = {
+        "Accept": "image/avif,image/webp,image/apng,image/*,*/*;q=0.8",
+        "Accept-Encoding": "identity",
+        "Referer": "https://www.douyin.com/",
+        "User-Agent": (
+            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
+            "AppleWebKit/537.36 (KHTML, like Gecko) "
+            "Chrome/126.0.0.0 Safari/537.36"
+        ),
+    }
+    for target_url in unique_urls:
+        try:
+            candidate = await session.get(
+                target_url,
+                headers=request_headers,
+                proxy=proxy or None,
+                timeout=aiohttp.ClientTimeout(
+                    total=12,
+                    connect=5,
+                    sock_connect=5,
+                    sock_read=12,
+                ),
+            )
+            candidate_type = candidate.headers.get("Content-Type", "image/jpeg")
+            if candidate.status >= 400:
+                last_error = f"抖音图片返回 {candidate.status}"
+                candidate.release()
+                continue
+            if not candidate_type.lower().startswith("image/"):
+                last_error = f"抖音图片格式无效：{candidate_type}"
+                candidate.release()
+                continue
+            upstream = candidate
+            content_type = candidate_type
+            break
+        except Exception as exc:
+            last_error = str(exc)
+    if upstream is None:
+        await session.close()
+        raise HTTPException(status_code=502, detail=last_error)
+
+    async def image_body():
+        try:
+            async for chunk in upstream.content.iter_chunked(64 * 1024):
+                if chunk:
+                    yield chunk
+        finally:
+            upstream.release()
+            await session.close()
+
+    return StreamingResponse(
+        image_body(),
+        status_code=upstream.status,
+        media_type=content_type,
+        headers={
+            "Cache-Control": "private, max-age=1800",
+            "X-Content-Type-Options": "nosniff",
+        },
+    )
+
+
+async def _persist_library_catalog(
+    deps: "_SessionDeps",
+    mode: str,
+    items: List[Dict[str, Any]],
+) -> Dict[str, Any]:
+    """原子替换一个来源的当前 50/100 条快照，避免资料库无限增长。"""
+    synced_at = _now_utc_iso()
+    limit = min(len(items), MAX_SYNC_COUNT)
+    records = [
+        _catalog_record(
+            item,
+            mode=mode,
+            source_rank=index,
+            synced_at=synced_at,
+        )
+        for index, item in enumerate(items[:limit])
+        if str(item.get("aweme_id") or "").strip()
+    ]
+    async with deps.catalog_lock:
+        data = await _read_library_catalog(deps.catalog_path)
+        data["modes"][mode] = {
+            "items": records,
+            "synced_at": synced_at,
+        }
+        payload = json.dumps(data, ensure_ascii=False, indent=2)
+        temp_path = deps.catalog_path.with_suffix(".tmp")
+        async with aiofiles.open(temp_path, "w", encoding="utf-8") as file:
+            await file.write(payload)
+        loop = asyncio.get_running_loop()
+        await loop.run_in_executor(None, temp_path.replace, deps.catalog_path)
+    return {
+        "mode": mode,
+        "count": len(records),
+        "synced_at": synced_at,
+    }
+
+
+def _infer_item_source_mode(item: Dict[str, Any]) -> str:
+    paths = item.get("file_paths")
+    if not isinstance(paths, list):
+        return "unknown"
+    for raw_path in paths:
+        segments = str(raw_path or "").replace("\\", "/").lower().split("/")
+        for segment in segments:
+            if segment in {"like", "post", "collect"}:
+                return segment
+            if segment in {"collection", "collectmix"}:
+                return "collect"
+    return "unknown"
+
+
+def _parse_cookie_input(raw: Optional[str]) -> Dict[str, str]:
+    """接受 ``k=v; k2=v2`` 或 JSON dict，返回干净 dict。"""
+    if not raw:
+        return {}
+    raw = raw.strip()
+    if raw.startswith("{"):
+        try:
+            obj = json.loads(raw)
+            if isinstance(obj, dict):
+                return {str(k): str(v) for k, v in obj.items() if v is not None}
+        except json.JSONDecodeError:
+            pass
+    cookies: Dict[str, str] = {}
+    for part in raw.split(";"):
+        if "=" not in part:
+            continue
+        k, _, v = part.partition("=")
+        k = k.strip()
+        v = v.strip()
+        if k:
+            cookies[k] = v
+    return cookies
+
+
+def _session_scope(
+    value: Optional[str] = Header(default=None, alias="X-Zhicui-Scope"),
+) -> str:
+    """Validate the opaque namespace supplied by the loopback Zhicui backend.
+
+    Header-less requests keep the reference project's standalone Web console
+    working in the legacy ``default`` namespace. Zhicui always sends a random
+    per-user scope.
+    """
+    if value is None or not value.strip():
+        return DEFAULT_SESSION_SCOPE
+    scope = value.strip()
+    if not SESSION_SCOPE_PATTERN.fullmatch(scope):
+        raise HTTPException(status_code=400, detail="会话作用域无效")
+    return scope
+
