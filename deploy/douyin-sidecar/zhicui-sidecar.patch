+<script>
+const $ = (id) => document.getElementById(id);
+async function json(path, opts) {
+  const res = await fetch(path, { headers: { 'Content-Type': 'application/json' }, ...opts });
+  let data = null; try { data = await res.json(); } catch {}
+  if (!res.ok) throw new Error((data && (data.detail || data.error)) || `HTTP ${res.status}`);
+  return data;
+}
+function encodePath(p) { return (p || '').split('/').map(encodeURIComponent).join('/'); }
+
+// ---- cookie ----
+async function loadCookies() {
+  try {
+    const d = await json('/api/v1/cookies');
+    const valid = d.valid ? '<span class="ok">✓ 已登录</span>' : '<span class="bad">✗ 未登录</span>';
+    const names = new Set(d.cookie_names || []);
+    const missing = ['ttwid','odin_tt','passport_csrf_token','sid_guard'].filter(k => !names.has(k));
+    $('cookieStatus').innerHTML = `${valid} · ${d.count} 条 cookie` + (missing.length && !d.valid ? ` · <span class="warn">缺 ${missing.join(', ')}</span>` : '');
+    return d.valid;
+  } catch (e) {
+    $('cookieStatus').innerHTML = `<span class="bad">读取失败: ${e.message}</span>`;
+    return false;
+  }
+}
+function toggleManual() { $('manualBox').classList.toggle('hidden'); }
+async function saveCookie() {
+  const cookie = $('cookieInput').value.trim();
+  if (!cookie) { alert('请粘贴 cookie'); return; }
+  try {
+    const d = await json('/api/v1/cookies', { method: 'POST', body: JSON.stringify({ cookie }) });
+    $('cookieStatus').innerHTML = d.valid ? `<span class="ok">✓ 已登录</span> · ${d.count} 条 cookie` : `<span class="bad">✗ 缺关键字段</span> · ${d.count} 条`;
+  } catch (e) { alert('保存失败: ' + e.message); }
+}
+
+// ---- 喜欢/收藏同步状态 ----
+function probeStatus(sc) {
+  if (!sc.running) return { text: '已停止', cls: 'stop' };
+  if (sc.last_success_count > 0) return { text: '最近放行', cls: 'open' };
+  if (sc.action === '等待风控窗口放行') return { text: '风控中', cls: 'wait' };
+  if (sc.action === '自动补一次全量同步') return { text: '同步中', cls: 'open' };
+  if (sc.action && sc.action.indexOf('已自动同步') === 0) return { text: '已同步', cls: 'open' };
+  return { text: '运行中', cls: 'half' };
+}
+function fmtLocal(iso) { if (!iso) return '—'; const d = new Date(iso); return isNaN(d) ? iso : d.toLocaleString('zh-CN', { hour12: false }); }
+function fmtWait(sec) {
+  if (!sec) return '—';
+  if (sec < 60) return `${sec} 秒`;
+  if (sec < 3600) return `${Math.round(sec / 60)} 分钟`;
+  if (sec < 86400) return `${(sec / 3600).toFixed(1)} 小时`;
+  return `${(sec / 86400).toFixed(1)} 天`;
+}
+function probeRowBody(label, sc) {
+  if (!sc) return '';
+  const st = probeStatus(sc);
+  const intervalHtml = sc.running
+    ? `<span><span class="probe-key">${label}下次探测约</span> <b>${fmtWait(sc.interval_seconds)}</b> 后</span>` : '';
+  const lastHtml = sc.last_check_at
+    ? `<span><span class="probe-key">${label}最近探测</span> <b>${fmtLocal(sc.last_check_at)}</b></span>` : '';
+  const openHtml = sc.last_open_at
+    ? `<span><span class="probe-key">${label}最近放行</span> <b>${fmtLocal(sc.last_open_at)}</b>（${sc.last_success_count} 条）</span>` : '';
+  return `<span class="probe-status ${st.cls}">${label}${st.text}</span>
+    <span class="probe-action">${escapeHtml(sc.action || (sc.running ? '等待首次探测' : ''))}</span>
+    <span class="probe-meta">${intervalHtml}${lastHtml}${openHtml}</span>`;
+}
+function probeRowHtml(sc) {
+  const like = probeRowBody('喜欢·', sc);
+  const col = sc.collection ? probeRowBody('收藏·', sc.collection) : '';
+  return `<div class="probe-row">
+    <div class="probe-top">
+      <span class="pill">${sc.scope_prefix}…</span>
+      <span class="probe-title">${escapeHtml(sc.action || (sc.running ? '等待首次探测' : ''))}</span>
+    </div>
+    <div class="probe-lane">${like}</div>
+    ${col ? `<div class="probe-lane">${col}</div>` : ''}
+  </div>`;
+}
+async function loadProbe() {
+  const card = $('probeCard');
+  if (!card) return;
+  try {
+    const d = await json('/api/v1/health');
+    const lp = (d && d.like_probe) || {};
+    if (!lp.enabled) {
+      card.style.display = 'none';
+      return;
+    }
+    card.style.display = '';
+    const scopes = (lp.scopes || []).filter(s => s.running || s.collection && s.collection.running || s.last_check_at);
+    $('probeMeta').textContent = `${scopes.length} 个会话`;
+    if (!scopes.length) {
+      $('probeList').innerHTML = '<div class="empty">暂无已登录会话，登录后自动开始</div>';
+      return;
+    }
+    $('probeList').innerHTML = '<div class="probe-grid">' + scopes.map(probeRowHtml).join('') + '</div>';
+  } catch (e) {
+    $('probeList').innerHTML = `<div class="empty">状态读取失败: ${e.message}</div>`;
+  }
+}
+
+// ---- 扫码 ----
+let scanPoll = null;
+async function startScan() {
+  const btn = $('scanBtn'); btn.disabled = true;
+  $('scanStatus').innerHTML = '<span class="warn">正在启动浏览器…</span>';
+  try {
+    await json('/api/v1/fetch-cookie', { method: 'POST', body: JSON.stringify({}) });
+    $('scanStatus').innerHTML = '<span class="warn">浏览器已弹出，请用抖音 App 扫码登录（登录后自动提取）</span>';
