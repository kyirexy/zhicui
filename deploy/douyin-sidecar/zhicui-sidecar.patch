+async def _browser_library_fallback(
+    api_client,
+    deps: "_SessionDeps",
+    mode: str,
+    sec_uid: str,
+    limit: int,
+) -> List[Dict[str, Any]]:
+    """用登录浏览器复用站内 XHR，兜底同步喜欢/收藏元数据。
+
+    抖音对 ``favorite/`` 与 ``listcollection/`` 的纯 HTTP 签名翻页会 403
+    （Argus/UIFID 签名校验），但登录页自己的浏览器 XHR 携带页面算出的有效
+    签名。这里复用 ``collect_aweme_ids_via_browser``：喜欢需要真 sec_uid +
+    点击 ``semiTablike`` tab，收藏走 ``showTab=favorite_collection`` 直达
+    （cookie 作用域，无需 sec_uid）。返回按浏览器顺序排列的 aweme 字典。
+    """
+    if mode not in {"like", "collection"}:
+        return []
+    browser_cfg = deps.config.get("browser_fallback", {}) or {}
+    if not browser_cfg.get("enabled", True):
+        logger.info("Library browser fallback skipped: disabled by config")
+        return []
+
+    # 两种模式都要求真 sec_uid：喜欢/收藏直达 URL 用 /user/{sec_uid}
+    # 才能携带 showTab 触发对应 XHR；/user/self 会被站点重定向并丢掉 showTab。
+    if not sec_uid or sec_uid == "self":
+        sec_uid = await _resolve_self_sec_uid(api_client)
+    if not sec_uid:
+        logger.warning("Library browser fallback for %s: no sec_uid resolved", mode)
+        return []
+
+    if mode == "like":
+        # 不带 showTab：落到用户主页后由显式点击 [id="semiTablike"] 触发
+        # favorite/ XHR。带 showTab=like 会让页面在 session 就绪前自动拉一次
+        # 空结果，之后点击不再触发新 XHR（probe2 实测 title 为空、0 命中）。
+        target_url = f"{DouyinAPIClient.BASE_URL}/user/{sec_uid}"
+        xhr_path_filter = "/aweme/v1/web/aweme/favorite/"
+        tab_selector = '[id="semiTablike"]'
+    else:
+        target_url = (
+            f"{DouyinAPIClient.BASE_URL}/user/{sec_uid}"
+            "?showTab=favorite_collection&from_tab_name=main"
+        )
+        xhr_path_filter = "/aweme/v1/web/aweme/listcollection/"
+        tab_selector = ""
+
+    # 反爬策略随账号状态变化：此前 like 的 favorite/ 用 headless Chromium
+    # 能拿到 aweme_list（probe6 实测 19 条），于是强制 headless。但线上
+    # E2E 实测 headless 下页面 SPA 不挂载（title 恒为空），所有 favorite/
+    # XHR 被护航域 www-hj.douyin.com 拦截成 200 空 body；而 collection 用
+    # 可见 Chrome（headless=false）首个 XHR 即命中真实 www.douyin.com 拿到
+    # aweme_list=10。因此 like 与 collection 统一跟随配置（默认可见浏览器），
+    # 不让 headless 触发护航风控。
+    configured_headless = bool(browser_cfg.get("headless", False))
+    fallback_headless = configured_headless
+    if not fallback_headless:
+        logger.info(
+            "Library browser fallback for %s: headless=False (visible browser)",
+            mode,
+        )
+
+    # 关键：持久化浏览器 profile。冷启动的 Chromium 每次都是全新反爬指纹，
+    # UIFID/msToken/bd-ticket 与 localStorage 反爬状态都从零开始，favorite/
+    # 首次 XHR 必被护航到 www-hj.douyin.com（HTTP 200 空 body）。只有跨运行
+    # 保留 profile，站点累积的反爬预热状态才能让后续 XHR 命中真实域拿数据。
+    profile_root = browser_cfg.get("profile_dir", "")
+    if not profile_root:
+        profile_root = str(
+            Path(__file__).resolve().parents[1] / "Downloaded" / ".browser-profiles"
+        )
+    try:
+        profile_dir = os.path.join(profile_root, scope_dir_safe(deps.scope), mode)
+    except Exception as exc:
+        logger.warning("Library browser fallback profile dir failed: %s", exc)
+        profile_dir = ""
+
+    try:
+        ids = await api_client.collect_aweme_ids_via_browser(
+            target_url=target_url,
+            xhr_path_filter=xhr_path_filter,
+            tab_selector=tab_selector,
+            include_login_cookies=True,
+            expected_count=limit,
+            headless=fallback_headless,
+            max_scrolls=int(browser_cfg.get("max_scrolls", 240) or 240),
+            idle_rounds=int(browser_cfg.get("idle_rounds", 8) or 8),
+            wait_timeout_seconds=int(browser_cfg.get("wait_timeout_seconds", 600) or 600),
+            stat_prefix=mode,
+            profile_dir=profile_dir,
+        )
+    except Exception as exc:
+        logger.warning("Library browser fallback failed for %s: %s", mode, exc)
+        return []
+
+    item_map = api_client.pop_browser_tab_aweme_items() or {}
+    challenge = api_client.pop_browser_last_challenge()
+    if challenge and not item_map:
+        source_label = "喜欢" if mode == "like" else "收藏"
+        if mode == "like" and "www-hj.douyin.com" in challenge:
+            raise RuntimeError(
+                f"未读取到{source_label}：{source_label}接口当前被抖音风控护航"
+                "（请求被路由到挑战域 www-hj.douyin.com，200 空响应）：登录态有效、"
+                "收藏等其他接口正常，只是该账号的喜欢接口被临时限制。请稍后重试，"
+                "或先在抖音网页端手动打开一次「喜欢」页让风控放行。"
+            )
+        raise RuntimeError(f"未读取到{source_label}：{challenge}")
+    ordered: List[Dict[str, Any]] = []
+    for aweme_id in ids:
