+            browser_items = await _browser_creator_catalog(deps, api_client, state, profile_count)
+            selected = browser_items[offset : offset + page_size]
+            next_offset = offset + len(selected)
+            has_more = next_offset < len(browser_items)
+            return {
+                "items": selected,
+                "next_cursor": f"browser:{next_offset}" if has_more else None,
+                "has_more": has_more,
