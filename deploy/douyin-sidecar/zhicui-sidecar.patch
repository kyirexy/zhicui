+async def _fetch_library_metadata(
+    deps: "_SessionDeps",
+    mode: str,
+    count: int,
+    progress_callback: Optional[ProgressCallback] = None,
+) -> Dict[str, int]:
+    """读取用户选择范围内的元数据，不下载、缓存或持久化任何视频文件。"""
+    safe_mode = mode if mode in {"collection", "like", "post"} else "collection"
+    limit = _bounded_sync_count(count)
+    ordered_items: List[Dict[str, Any]] = []
+    cursor = 0
+    has_more = True
+
     async with DouyinAPIClient(
         deps.cookie_manager.get_cookies(),
         proxy=deps.config.get("proxy"),
     ) as api_client:
+        sec_uid = "self"
+        if safe_mode in {"like", "post"}:
+            sec_uid = await _resolve_self_sec_uid(api_client)
+            if not sec_uid:
+                raise RuntimeError("未能识别当前抖音账号，请重新扫码登录")
+        fetch_page = {
+            "collection": api_client.get_user_collection,
+            "like": api_client.get_user_like,
+            "post": api_client.get_user_post,
+        }[safe_mode]
+        while has_more and len(ordered_items) < limit:
+            await deps.rate_limiter.acquire()
+            request_cursor = cursor
+            page = await fetch_page(sec_uid, request_cursor, min(20, limit - len(ordered_items)))
+            page_items = page.get("items") if isinstance(page, dict) else None
+            if not isinstance(page_items, list) or not page_items:
+                break
+            ordered_items.extend(item for item in page_items if isinstance(item, dict))
+            if progress_callback is not None:
+                # 拖页或重试可能返回重复作品，进度必须按去重后的
+                # 真实资料数统计，不能直接累加每页长度。
+                progress_callback(
+                    len(_unique_aweme_ids(ordered_items, limit)),
