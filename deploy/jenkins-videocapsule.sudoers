jenkins ALL=(root) NOPASSWD: /bin/systemctl restart videocapsule-backend, /bin/systemctl restart videocapsule-frontend, /bin/systemctl stop videocapsule-frontend, /bin/systemctl start videocapsule-frontend, /bin/systemctl start zhicui-postgres-backup.service, /bin/systemctl start zhicui-postgres-restore-verify.service, /bin/systemctl status videocapsule*, /usr/sbin/nginx -t
