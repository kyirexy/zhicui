# 复制为 deploy/omniroute/.env。不要提交真实值。
# python -c "import secrets; print(secrets.token_urlsafe(48))"
OMNIROUTE_API_KEY=replace-with-a-long-random-key

# OmniRoute 管理面板会使用下面三个独立密钥。
JWT_SECRET=replace-with-another-long-random-key
API_KEY_SECRET=replace-with-64-hex-characters
INITIAL_PASSWORD=replace-with-a-strong-admin-password

OMNIROUTE_PORT=20128
DISABLE_SQLITE_AUTO_BACKUP=false
