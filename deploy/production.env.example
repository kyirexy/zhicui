# 知萃生产后端模板。复制到 backend/.env 后仅在服务器填写秘密，禁止提交真实值。
DATABASE_URL=postgresql://zhicui:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/zhicui
JWT_SECRET=CHANGE_ME_64_HEX_OR_LONG_RANDOM
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

API_KEY=CHANGE_ME_ASR_API_KEY
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
LLM_MODEL=deepseek/deepseek-chat
LLM_API_BASE=

HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=https://luxai.cn,https://www.luxai.cn,https://localhost
RATE_LIMIT_ENABLED=true
OPS_MONITOR_ENABLED=true
ALERT_WEBHOOK_URL=
BACKUP_STATUS_FILE=/var/lib/zhicui-backups/latest.json
BACKUP_MAX_AGE_HOURS=36
# 以下媒体配置由生产 systemd 固定注入；本地开发可单独设置。
CASE_MEDIA_DIR=/var/lib/zhicui-case-media
CASE_MEDIA_MAX_TOTAL_MB=1024
CASE_MEDIA_MIN_FREE_MB=512
BACKUP_OFFSITE_REQUIRED=true
# 仅早期阶段且产品所有者明确接受单机故障域风险时，才可与上一项 false 配套开启。
EARLY_STAGE_LOCAL_BACKUP_ACCEPTED=false

DEV_AUTH_BYPASS=false
NEXT_PUBLIC_DEV_AUTH_AUTO=false
EMAIL_DELIVERY_ENABLED=true
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=CHANGE_ME_SENDER_AT_LUXAI_CN
SMTP_FROM_NAME=知萃
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
SMTP_READINESS_CACHE_SECONDS=300
VIDEO_ANALYSIS_ENABLED=true
AGENT_AUTOMATION_ENABLED=true
AGENT_AUTOMATION_POLL_SECONDS=30
# Stable 要求三个博主平台都在此时间窗内完成一次真实主页测试。
CREATOR_CONNECTOR_READINESS_MAX_AGE_HOURS=24
# Agent 的启用状态禁止写在此共享文件中；systemd 最后加载由 deploy.sh
# 原子管理的 /etc/zhicui/agent-interface.env，保证失败回滚一定恢复关闭。
# Pepper 必须是独立随机秘密（至少 32 字节），不得复用 JWT_SECRET。
AGENT_INTERFACE_USER_ALLOWLIST=
AGENT_INTERFACE_ACTION_ALLOWLIST=
AGENT_TOKEN_PEPPER=CHANGE_ME_INDEPENDENT_64_HEX_OR_LONG_RANDOM
PUBLIC_APP_URL=https://luxai.cn

# 博主同步开关与三平台健康状态保存在 system_settings；Stable 切换前必须
# 在管理端完成连接器测试并启用，readiness 会在任一依赖未就绪时失败关闭。
