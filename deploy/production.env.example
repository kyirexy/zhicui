# 知萃生产后端模板。复制到 backend/.env 后仅在服务器填写秘密，禁止提交真实值。
DATABASE_URL=postgresql://zhicui:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/zhicui
JWT_SECRET=CHANGE_ME_64_HEX_OR_LONG_RANDOM
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

API_KEY=CHANGE_ME_ASR_API_KEY
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
LLM_MODEL=deepseek/deepseek-chat
LLM_API_BASE=

HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=https://luxai.cn,https://www.luxai.cn,https://localhost
RATE_LIMIT_ENABLED=true
OPS_MONITOR_ENABLED=true
ALERT_WEBHOOK_URL=
BACKUP_STATUS_FILE=/var/lib/zhicui-backups/latest.json
BACKUP_MAX_AGE_HOURS=36
BACKUP_OFFSITE_REQUIRED=true
# 仅早期阶段且产品所有者明确接受单机故障域风险时，才可与上一项 false 配套开启。
EARLY_STAGE_LOCAL_BACKUP_ACCEPTED=false

DEV_AUTH_BYPASS=false
NEXT_PUBLIC_DEV_AUTH_AUTO=false
EMAIL_DELIVERY_ENABLED=false
VIDEO_ANALYSIS_ENABLED=false
AGENT_AUTOMATION_ENABLED=true
PUBLIC_APP_URL=https://luxai.cn

# 可选平台能力；只在对应服务完成健康检查后开启。
CREATOR_SYNC_ENABLED=false
DOUYIN_CREATOR_SYNC_ENABLED=false
BILIBILI_CREATOR_SYNC_ENABLED=false
