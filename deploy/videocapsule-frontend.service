[Unit]
Description=VideoCapsule Frontend (blue-green coordinator)
After=network.target videocapsule-backend.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/zhicui-deploy/frontend-supervisor.sh start
ExecStop=/usr/local/lib/zhicui-deploy/frontend-supervisor.sh stop

[Install]
WantedBy=multi-user.target
