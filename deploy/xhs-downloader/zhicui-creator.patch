+def _zhicui_unwrap(value):
+    """Remove Vue ref wrappers without returning an upstream response object."""
+    while isinstance(value, dict):
+        if "_rawValue" in value:
+            value = value["_rawValue"]
+            continue
+        if "_value" in value:
+            value = value["_value"]
+            continue
+        break
+    return value
+
+
+def _zhicui_profile_cards(state: dict) -> list[dict]:
+    user = _zhicui_unwrap((state or {}).get("user") or {})
+    notes = _zhicui_unwrap((user or {}).get("notes") or {}) if isinstance(user, dict) else {}
+    groups = list(notes.values()) if isinstance(notes, dict) else notes
+    if not isinstance(groups, list):
+        return []
+    cards: list[dict] = []
+    for group in groups:
+        group = _zhicui_unwrap(group)
+        if not isinstance(group, list):
+            continue
+        for raw in group:
+            if not isinstance(raw, dict):
+                continue
+            card = _zhicui_unwrap(raw.get("noteCard") or raw.get("note_card") or {})
+            note_id = str(raw.get("id") or raw.get("noteId") or "").strip()
+            token = str(raw.get("xsecToken") or raw.get("xsec_token") or "").strip()
+            if isinstance(card, dict) and note_id:
+                cards.append({"id": note_id, "token": token, "card": card})
+    seen: set[str] = set()
+    return [item for item in cards if not (item["id"] in seen or seen.add(item["id"]))]
+
+
+def _zhicui_creator_payload(creator_id: str, cards: list[dict]) -> dict:
+    first = cards[0]["card"] if cards else {}
+    user = _zhicui_unwrap(first.get("user") or {}) if isinstance(first, dict) else {}
+    avatar = ""
+    if isinstance(user, dict):
+        images = user.get("avatar") or user.get("image") or user.get("images") or ""
+        if isinstance(images, str):
+            avatar = images
+        elif isinstance(images, dict):
+            avatar = str(images.get("urlDefault") or images.get("url") or "")
+    return {
+        "creator_id": creator_id,
+        "display_name": str(
+            (user.get("nickName") or user.get("nickname") or "小红书博主")
+            if isinstance(user, dict) else "小红书博主"
+        )[:160],
+        "avatar_url": avatar[:2048],
+    }
+
+
+def _zhicui_work_payload(item: dict) -> dict:
+    card = item["card"]
+    note_id = item["id"]
+    user = _zhicui_unwrap(card.get("user") or {})
+    cover = _zhicui_unwrap(card.get("cover") or {})
+    work_type = str(card.get("type") or "").lower()
+    if not work_type and card.get("video"):
+        work_type = "video"
+    canonical = f"https://www.xiaohongshu.com/explore/{note_id}"
+    token = item.get("token") or ""
+    fetch_url = canonical + (
+        f"?xsec_token={token}&xsec_source=pc_user" if token else ""
+    )
+    return {
+        "note_id": note_id,
+        "title": str(card.get("displayTitle") or card.get("title") or "小红书作品")[:240],
+        "desc": str(card.get("desc") or "")[:2000],
+        "type": "video" if work_type == "video" else "image",
+        "author_name": str(
+            (user.get("nickName") or user.get("nickname") or "")
+            if isinstance(user, dict) else ""
+        )[:160],
+        "source_url": canonical,
+        "fetch_url": fetch_url,
+        "cover_url": str(
+            (cover.get("urlDefault") or cover.get("url") or "")
+            if isinstance(cover, dict) else ""
+        )[:2048],
+    }
+
