+        async def creator_state(profile_url: str, cookie: str):
+            parsed = urlparse(profile_url)
+            if (
+                parsed.scheme != "https"
+                or parsed.hostname != "www.xiaohongshu.com"
+                or not parsed.path.startswith("/user/profile/")
+            ):
+                return "", [], "仅支持小红书官方博主主页"
+            creator_id = parsed.path.split("/user/profile/", 1)[1].split("/", 1)[0]
+            if not creator_id or not creator_id.replace("-", "").replace("_", "").isalnum():
+                return "", [], "博主 ID 无效"
+            html = await self.html.request_url(profile_url, cookie=cookie)
+            try:
+                raw_state = self.convert._convert_object(
+                    self.convert._extract_object(html)
+                )
+            except Exception:
+                return creator_id, [], "博主主页数据格式异常"
+            return creator_id, _zhicui_profile_cards(raw_state), ""
+
+        @server.post(
