{
  "name": "zhicui-desktop",
  "version": "1.0.10",
  "releaseChannel": "beta",
  "description": "知萃 Windows 桌面应用",
  "main": "dist/main.js",
  "author": "知萃",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "patch:builder": "node scripts/patch-electron-builder.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../scripts/start-desktop-dev.ps1",
    "dev:electron": "npm run build && electron .",
    "verify:platform-account": "npm run build && node scripts/verify-platform-account.mjs",
    "verify:update-policy": "npm run build && node scripts/verify-update-policy.mjs",
    "verify:release-contract": "npm run build && node scripts/verify-release-contract.mjs",
    "pack": "npm run build && npm run patch:builder && electron-builder --dir --win --x64",
    "dist:win": "npm run build && npm run patch:builder && electron-builder --win nsis --x64",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "playwright-core": "^1.62.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "cn.luxai.desktop",
    "productName": "知萃",
    "artifactName": "Zhicui-Setup-${version}-${arch}.${ext}",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release-${version}"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/playwright-core/types/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/public/icons/icon-512.png",
        "to": "app-icon.png"
      }
    ],
    "protocols": [
      {
        "name": "知萃",
        "schemes": [
          "zhicui"
        ]
      }
    ],
    "win": {
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "verifyUpdateCodeSignature": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../frontend/public/icons/desktop-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "知萃",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://luxai.cn/download/windows/",
        "channel": "beta"
      }
    ]
  }
}
