{
  "name": "frontend",
  "version": "1.1.9",
  "private": true,
  "scripts": {
    "generate:build-version": "node scripts/generate-build-version.mjs",
    "predev": "npm run generate:build-version",
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "prebuild": "npm run generate:build-version",
    "build": "next build",
    "typecheck": "npm run generate:build-version && tsc --noEmit",
    "test:agent-v2": "node --experimental-strip-types --test src/lib/agentTurnUi.test.ts src/lib/agentTextStream.test.ts",
    "test:navigation": "node --experimental-strip-types --test src/lib/productNavigation.test.ts",
    "test:douyin-sync": "node --experimental-strip-types --test src/lib/douyinSyncFeedback.test.ts",
    "test:manual-sync": "node --experimental-strip-types --test src/lib/manualSyncPolicy.test.ts",
    "test:client-update": "npm run generate:build-version && node --experimental-strip-types --test src/lib/webBuildUpdate.test.ts src/lib/clientAuthPolicy.test.ts",
    "start": "next start",
    "cap:build": "npm run generate:build-version && CAPACITOR_BUILD=true NEXT_PUBLIC_API_URL=http://10.0.2.2:8000 next build && cap sync android",
    "cap:build:prod": "npm run generate:build-version && CAPACITOR_BUILD=true NEXT_PUBLIC_API_URL=https://luxai.cn next build && cap sync android",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lobehub/icons": "^5.15.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "canvas-confetti": "^1.9.4",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "streamdown": "^2.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
