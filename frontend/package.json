{
  "name": "frontend",
  "version": "1.1.10",
  "private": true,
  "scripts": {
    "generate:build-version": "node scripts/generate-build-version.mjs",
    "predev": "npm run generate:build-version",
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "prebuild": "npm run generate:build-version",
    "build": "next build",
    "typecheck": "npm run generate:build-version && tsc --noEmit",
    "test:agent-access": "node --experimental-strip-types --test src/lib/agentAccessUi.test.ts src/lib/agentStableReleaseMetadata.test.ts",
    "test:agent-v2": "node --experimental-strip-types --test src/lib/agentTurnUi.test.ts src/lib/agentTextStream.test.ts src/lib/agentMarkdownStream.test.ts src/lib/agentScrollFollow.test.ts src/lib/agentMobileParity.test.ts",
    "test:navigation": "node --experimental-strip-types --test src/lib/productNavigation.test.ts src/lib/marketingHomepage.test.ts",
    "test:mobile-feedback": "node --experimental-strip-types --test src/lib/mobileFeedbackEntry.test.ts",
    "test:douyin-sync": "node --experimental-strip-types --test src/lib/douyinSyncFeedback.test.ts",
    "test:douyin-desktop": "node --experimental-strip-types --test src/lib/douyinDesktopSync.test.ts",
    "test:manual-sync": "node --experimental-strip-types --test src/lib/manualSyncPolicy.test.ts src/lib/libraryMultiSourceSync.test.ts",
    "test:client-update": "npm run generate:build-version && node --experimental-strip-types --test src/lib/webBuildUpdate.test.ts src/lib/clientAuthPolicy.test.ts src/lib/mobileUpdatePromptUi.test.ts",
    "test:public-release": "node --experimental-strip-types --test src/lib/clientAuthPolicy.test.ts src/lib/publicReleaseContract.test.ts",
    "test:desktop-login": "node --experimental-strip-types --test src/lib/desktopLogin.test.ts",
    "verify:public-browser": "node scripts/verify-public-release-browser.mjs",
    "start": "next start",
    "cap:build": "npm run generate:build-version && CAPACITOR_BUILD=true NEXT_PUBLIC_API_URL=http://10.0.2.2:8000 next build && cap sync android",
    "cap:build:prod": "npm run generate:build-version && CAPACITOR_BUILD=true NEXT_PUBLIC_API_URL=https://luxai.cn next build && cap sync android",
    "cap:sync": "cap sync android",
    "ios:build:prod": "node scripts/build-ios-web.mjs",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "test:ios": "node --experimental-strip-types --test src/lib/iosMobile.test.ts",
    "test:file-export": "node --experimental-strip-types --test src/lib/fileExportCore.test.ts",
    "cap:run:live": "cap run android --live-reload --host 127.0.0.1 --port 3000 --forwardPorts 3000:3000 --forwardPorts 8000:8000",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "8.1.1",
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "8.5.1",
    "@capacitor/share": "^8.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lobehub/icons": "5.16.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "canvas-confetti": "^1.9.4",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.17.0",
    "next": "16.3.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "streamdown": "2.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "brace-expansion": "5.0.9",
    "dompurify": "3.4.14",
    "mermaid": "11.17.2",
    "tar": "7.5.22",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
